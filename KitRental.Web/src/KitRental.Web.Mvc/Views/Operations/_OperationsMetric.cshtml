@model OperationsMetricViewModel
@{
    var route = new Dictionary<string, string> { ["customerId"] = Model.CustomerId?.ToString() ?? "" };
    if (Model.FilterName is not null) route[Model.FilterName] = Model.FilterValue ?? "";
}
<a class="ops-metric ops-tone-@Model.Tone" asp-action="@Model.Action" asp-all-route-data="route">
    <span class="ops-metric-label">@Model.Label <i data-lucide="@Model.Icon" aria-hidden="true"></i></span>
    <strong>@Model.Count.ToString("N0")</strong>
    <small>@Model.Description <span aria-hidden="true">→</span></small>
</a>
