@model InventoryScreenViewModel
@{
    ViewData["Title"] = "Envanter";
    var shipmentFilterOptions = Model.Result.Items
        .Select(item => item.ShipmentState == 6 ? "Hata" : item.ShipmentStatusLabel ?? "Başlatılmadı")
        .Append("Başlatılmadı")
        .Append("Hata")
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(status => status, StringComparer.CurrentCultureIgnoreCase)
        .ToArray();
}
<div class="page-heading"><div><span class="eyebrow">FİZİKSEL TAKİP</span><h1>Envanter</h1><p class="block-muted">Oluşturulmuş tüm fiziksel kitleri, atanan öğrenci ve güncel kargo bilgileriyle takip edin.</p></div><a class="primary-action" asp-controller="PhysicalKits" asp-action="Create">+ Fiziksel Kit Oluştur</a></div>

@if (Model.Result.Items.Count == 0)
{
    <div class="empty">Filtrelere uygun fiziksel kit bulunamadı.</div>
}
else
{
    <div class="table-scroll">
        <table class="order-kits-table student-order-table inventory-order-table js-datatable"
               data-datatable-responsive="false"
               data-datatable-page-length="10"
               data-datatable-column-filters="true">
            <thead>
                <tr><th>Öğrenci</th><th>Telefon</th><th>Fiziksel Kit</th><th>Kargo Durumu</th><th>Takip No</th><th>Adres</th><th>Adres Linki</th><th>İşlem</th></tr>
                <tr class="column-filter-row" data-dt-order="disable">
                    <th><input type="search" data-column-filter aria-label="Öğrenci sütununu filtrele" placeholder="Öğrenci filtrele" autocomplete="off" /></th>
                    <th><input type="search" data-column-filter aria-label="Telefon sütununu filtrele" placeholder="Telefon filtrele" autocomplete="off" /></th>
                    <th><input type="search" data-column-filter aria-label="Fiziksel kit sütununu filtrele" placeholder="Kit filtrele" autocomplete="off" /></th>
                    <th>
                        <div class="column-multi-filter" data-multi-filter>
                            <button class="column-multi-filter-toggle" type="button" data-multi-filter-toggle aria-haspopup="listbox" aria-expanded="false" aria-label="Kargo durumu filtresini aç">Tümü</button>
                            <div class="column-multi-filter-menu" data-multi-filter-menu role="group" aria-label="Kargo durumu seçenekleri" hidden>
                                <label><input type="checkbox" value="" data-multi-filter-option checked /> <span>Tümü</span></label>
                                @foreach (var status in shipmentFilterOptions)
                                {
                                    <label><input type="checkbox" value="@status" data-multi-filter-option /> <span>@status</span></label>
                                }
                            </div>
                            <select multiple data-column-filter data-column-filter-multi="true" aria-label="Kargo durumu sütununu filtrele" hidden tabindex="-1">
                                <option value="">Tümü</option>
                                @foreach (var status in shipmentFilterOptions)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                    </th>
                    <th><input type="search" data-column-filter aria-label="Takip numarası sütununu filtrele" placeholder="Takip no filtrele" autocomplete="off" /></th>
                    <th>
                        <select data-column-filter data-column-filter-regex="true" aria-label="Adres sütununu filtrele">
                            <option value="">Tümü</option>
                            <option value="\S+">Adresi Girilenler</option>
                            <option value="^\s*$">Adresi Girilmeyenler</option>
                        </select>
                    </th>
                    <th><input type="search" data-column-filter aria-label="Adres linki sütununu filtrele" placeholder="Adres linki filtrele" autocomplete="off" /></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Result.Items)
            {
                var hasAddress = !string.IsNullOrWhiteSpace(item.AddressLine);
                var addressUrl = string.IsNullOrWhiteSpace(item.PublicAddressToken)
                    ? string.Empty
                    : Url.Action("Index", "PublicStudentAddress", new { token = item.PublicAddressToken }, Context.Request.Scheme) ?? string.Empty;
                var shipmentStatus = item.ShipmentState == 6
                    ? "Hata"
                    : item.ShipmentStatusLabel ?? "Başlatılmadı";
                <tr>
                    <td><strong class="student-name-truncate" title="@(item.StudentName ?? "Atanmadı")">@(item.StudentName ?? "Atanmadı")</strong></td>
                    <td>@(item.GuardianPhone ?? "-")</td>
                    <td>
                        <a class="student-kit-serial-truncate" title="@item.SerialNumber" asp-controller="PhysicalKits" asp-action="Details" asp-route-id="@item.Id">@item.SerialNumber</a>
                        <small class="block-muted">@item.ProductModelName · @item.ProductModelSku</small>
                    </td>
                    <td>
                        @if (shipmentStatus is "Başlatılmadı" or "Hata")
                        {
                            <span class="line-pending">@shipmentStatus</span>
                        }
                        else
                        {
                            <span class="line-complete">@shipmentStatus</span>
                        }
                        @if (item.ShipmentUpdatedAt.HasValue)
                        {
                            <small class="block-muted">@(item.Carrier ?? "Aras Kargo") · @item.ShipmentUpdatedAt.Value.ToTurkeyTimeString("dd.MM.yyyy HH:mm")</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.ShipmentError))
                        {
                            <small class="block-muted" title="@item.ShipmentError">@item.ShipmentError</small>
                        }
                    </td>
                    <td>@(item.TrackingNumber ?? "-")</td>
                    <td>@if (hasAddress) { <span class="student-address-truncate" title="@item.AddressLine">@item.AddressLine</span> }</td>
                    <td>@if (!string.IsNullOrWhiteSpace(addressUrl)) { <a class="student-public-link-truncate" href="@addressUrl" target="_blank" rel="noopener" title="@addressUrl">@addressUrl</a> }</td>
                    <td><a class="icon-action icon-action-neutral" asp-controller="PhysicalKits" asp-action="Details" asp-route-id="@item.Id" title="Fiziksel kit detayını aç" aria-label="@item.SerialNumber fiziksel kit detayını aç"><i data-lucide="eye"></i><span class="visually-hidden">Detay</span></a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
