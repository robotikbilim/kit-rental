@model AdminOrderPageViewModel
@{ ViewData["Title"] = "Sipariş Oluştur"; }
<div class="form-shell form-shell-wide">
    <div class="form-heading"><a asp-action="Orders">← Siparişlere dön</a><span class="eyebrow">YENİ SİPARİŞ</span><h1>Yönetici siparişi oluştur</h1><p>Müşteriyi, eğitim kitini, kiralama dönemini ve gönderim yapılacak öğrenci listesini belirleyin. Adresler öğrencilere özel public linklerle toplanır.</p></div>
    <form class="catalog-form" asp-action="CreateOrder" method="post">
        <div asp-validation-summary="All" class="error"></div>
        <div class="form-section"><h2>Müşteri ve kiralama</h2><div class="form-grid">
            <div class="field"><label asp-for="Form.CustomerId"></label><select name="CustomerId" id="admin-order-customer"><option value="">Müşteri seçin</option>@foreach (var customer in Model.Customers) { <option value="@customer.Id" selected="@(customer.Id == Model.Form.CustomerId)">@customer.Name (@customer.Email)</option> }</select></div>
            <div class="field"><label asp-for="Form.ProductModelId"></label><select name="ProductModelId"><option value="">Eğitim kiti seçin</option>@foreach (var kit in Model.ProductModels) { <option value="@kit.Id" selected="@(kit.Id == Model.Form.ProductModelId)">@kit.Name (@kit.Sku)</option> }</select></div>
            <div class="field"><label asp-for="Form.StartDate"></label><input type="date" name="StartDate" value="@Model.Form.StartDate.ToString("yyyy-MM-dd")" /></div>
            <div class="field"><label asp-for="Form.EndDate"></label><input type="date" name="EndDate" value="@Model.Form.EndDate.ToString("yyyy-MM-dd")" /></div>
        </div></div>
        <div class="form-section"><div class="section-heading"><div><h2>Öğrenci listesi</h2><p>Her öğrenci için kişiye özel adres toplama linki sipariş detayında üretilecek.</p></div><button class="secondary-action" type="button" id="add-admin-order-student">+ Öğrenci Ekle</button></div>
            <div class="recipe-lines" id="admin-order-students">@for (var i = 0; i < Model.Form.Students.Count; i++) { <div class="recipe-line admin-order-student"><span class="line-number">@(i + 1)</span><div class="field"><label>Öğrenci adı soyadı</label><input name="Students[@i].FullName" value="@Model.Form.Students[i].FullName" autocomplete="name" /></div><div class="field"><label>Telefon numarası</label><input name="Students[@i].GuardianPhone" value="@Model.Form.Students[i].GuardianPhone" type="tel" inputmode="tel" data-phone-mask="tr" placeholder="0xxx xxx xx xx" /></div><button class="remove-line" type="button" title="Satırı kaldır">×</button></div> }</div>
        </div>
        <div class="form-actions"><a class="secondary-action" asp-action="Orders">Vazgeç</a><button class="primary-action" type="submit">Siparişi Oluştur</button></div>
    </form>
</div>
<template id="admin-order-student-template"><div class="recipe-line admin-order-student"><span class="line-number"></span><div class="field"><label>Öğrenci adı soyadı</label><input data-name="FullName" autocomplete="name" /></div><div class="field"><label>Telefon numarası</label><input data-name="GuardianPhone" type="tel" inputmode="tel" data-phone-mask="tr" placeholder="0xxx xxx xx xx" /></div><button class="remove-line" type="button" title="Satırı kaldır">×</button></div></template>
<script>
(() => {
 const box=document.querySelector('#admin-order-students'),tpl=document.querySelector('#admin-order-student-template');
 const renumber=()=>[...box.querySelectorAll('.admin-order-student')].forEach((row,i)=>{row.querySelector('.line-number').textContent=i+1;row.querySelectorAll('[name],[data-name]').forEach(el=>{const field=el.dataset.name||el.name.split('.').pop();el.name=`Students[${i}].${field}`;});});
 document.querySelector('#add-admin-order-student').addEventListener('click',()=>{box.append(tpl.content.cloneNode(true));renumber();});
 box.addEventListener('click',e=>{if(!e.target.classList.contains('remove-line'))return;if(box.children.length>1)e.target.closest('.admin-order-student').remove();renumber();});
 renumber();
})();
</script>
