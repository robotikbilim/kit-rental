@model FaultViewModel
@{
    var statusId = $"fault-status-{Model.Id:N}";
    var noteId = $"fault-note-{Model.Id:N}";
}
<details class="ops-fault-status-editor ops-fault-disclosure" data-fault-status-editor>
    <summary><span class="ops-fault-disclosure-title"><strong>Arıza Durumunu Güncelle</strong><small>Durumu değiştirebilir veya yalnızca not ekleyebilirsiniz</small></span></summary>
    <form class="ops-fault-status-form" asp-action="UpdateFault" asp-route-id="@Model.Id" method="post" data-fault-status-form aria-label="@($"{Model.Number} arıza durumunu güncelle veya not ekle")">
        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
        <div class="ops-fault-status-select-wrap">
            <label for="@statusId">Yeni durum <span>(isteğe bağlı)</span></label>
            <select id="@statusId" name="status">
                <option value="">Durumu değiştirme</option>
                @for (var status = 1; status <= 16; status++)
                {
                    if (status != Model.Status)
                    {
                        <option value="@status">@OperationsDisplay.FaultStatus(status)</option>
                    }
                }
            </select>
            <small>Mevcut durumdan bağımsız olarak yeni durumu seçebilirsiniz. Bu işlem kargo oluşturmaz veya kargo kayıtlarını değiştirmez.</small>
        </div>
        <div class="ops-fault-status-note">
            <label for="@noteId">Süreç notu</label>
            <textarea id="@noteId" name="note" rows="3" placeholder="İnceleme sonucu veya yapılan işlemi yazın…" aria-describedby="@(noteId)-help"></textarea>
            <small id="@(noteId)-help">Bu not müşteri portalında görünür. Durum seçmeden kaydederseniz mevcut durum korunur.</small>
        </div>
        <footer class="ops-fault-status-footer">
            <span data-fault-status-preview aria-live="polite">Durum seçin veya not girin.</span>
            <div><button class="secondary-action" type="button" data-fault-status-cancel>Vazgeç</button><button class="primary-action" type="submit" data-fault-status-save disabled>Kaydet</button></div>
        </footer>
    </form>
</details>
