@model OperationsOrdersScreen
@{
    ViewData["Title"] = "Siparişler";
    var canManageOrders = User.IsInRole("SystemAdmin") || User.IsInRole("OperationsManager");
    var first = Model.Result.TotalCount == 0 ? 0 : (Model.Result.Page - 1) * Model.Result.PageSize + 1;
    var last = Math.Min(Model.Result.Page * Model.Result.PageSize, Model.Result.TotalCount);
    Dictionary<string, string> PageRoute(int page) => new()
    {
        ["page"] = page.ToString(), ["pageSize"] = Model.Result.PageSize.ToString(),
        ["customerId"] = Model.Filter.CustomerId?.ToString() ?? "", ["query"] = Model.Filter.Query ?? "",
        ["type"] = Model.Filter.Type?.ToString() ?? "", ["status"] = Model.Filter.Status?.ToString() ?? "",
        ["focus"] = Model.Filter.Focus ?? "", ["sort"] = Model.Filter.Sort ?? "",
        ["endsFrom"] = Model.Filter.EndsFrom?.ToString("yyyy-MM-dd") ?? "",
        ["endsTo"] = Model.Filter.EndsTo?.ToString("yyyy-MM-dd") ?? ""
    };
}
<div class="ops-workspace">
    <header class="ops-hero">
        <div><a class="back-link" asp-action="Dashboard" asp-route-customerId="@Model.Filter.CustomerId">← Operasyon merkezi</a><span class="eyebrow">SİPARİŞ YÖNETİMİ</span><h1>Siparişler</h1><p>Hazırlığı, teslimatı ve kiralama sonrasındaki işlemleri sipariş bazında takip edin.</p></div>
        @if (canManageOrders) { <div class="heading-actions"><a class="secondary-action" asp-action="CreatePurchaseOrder">Satın alma oluştur</a><a class="primary-action" asp-action="CreateOrder"><i data-lucide="plus"></i> Kiralama oluştur</a></div> }
    </header>
    @if (TempData["Success"] is string success) { <div class="success-banner">@success</div> }
    @if (TempData["Error"] is string error) { <div class="error-banner">@error</div> }
    <form method="get" class="ops-filter-panel">
        <div class="field ops-filter-search"><label for="orders-query">Sipariş, müşteri, dönem veya kit</label><input type="search" id="orders-query" name="query" value="@Model.Filter.Query" placeholder="Sipariş numarası veya dönem adı…" /></div>
        <div class="field"><label for="orders-customer">Müşteri</label><select id="orders-customer" name="customerId"><option value="">Tüm müşteriler</option>@foreach (var customer in Model.Result.Customers) { <option value="@customer.Id" selected="@(customer.Id == Model.Filter.CustomerId)">@customer.Name</option> }</select></div>
        <div class="field"><label for="orders-focus">İşlem odağı</label><select id="orders-focus" name="focus"><option value="">Tüm kayıtlar</option>@foreach (var option in OperationsDisplay.FocusOptions) { <option value="@option.Key" selected="@(option.Key == Model.Filter.Focus)">@option.Value</option> }</select></div>
        <div class="field"><label for="orders-status">Sipariş durumu</label><select id="orders-status" name="status"><option value="">Tüm durumlar</option>@foreach (var option in OperationsDisplay.OrderStatuses) { <option value="@option.Key" selected="@(option.Key == Model.Filter.Status)">@option.Value</option> }</select></div>
        <div class="field"><label for="orders-type">Sipariş türü</label><select id="orders-type" name="type"><option value="">Tümü</option><option value="1" selected="@(Model.Filter.Type == 1)">Kiralama</option><option value="2" selected="@(Model.Filter.Type == 2)">Satın alma</option></select></div>
        <div class="field"><label for="orders-from">Dönem bitişi · en erken</label><input id="orders-from" name="endsFrom" type="date" value="@Model.Filter.EndsFrom?.ToString("yyyy-MM-dd")" /></div>
        <div class="field"><label for="orders-to">Dönem bitişi · en geç</label><input id="orders-to" name="endsTo" type="date" value="@Model.Filter.EndsTo?.ToString("yyyy-MM-dd")" /></div>
        <div class="field"><label for="orders-sort">Sıralama</label><select id="orders-sort" name="sort"><option value="">En yeni sipariş</option><option value="oldest" selected="@(Model.Filter.Sort == "oldest")">En eski sipariş</option><option value="end-date" selected="@(Model.Filter.Sort == "end-date")">Dönem bitişi yakın olan</option></select></div>
        <div class="field"><label for="orders-size">Sayfa başına</label><select id="orders-size" name="pageSize">@foreach (var size in new[] { 10, 20, 50, 100 }) { <option value="@size" selected="@(Model.Result.PageSize == size)">@size kayıt</option> }</select></div>
        <div class="ops-filter-actions"><button class="primary-action" type="submit">Filtrele</button><a class="secondary-action" asp-action="Orders">Temizle</a></div>
    </form>
    <div asp-validation-summary="All" class="error"></div>
    <div class="ops-result-heading"><span><b>@Model.Result.TotalCount</b> sipariş bulundu</span><span>İade ve arıza bilgileri siparişin tüm dönemini kapsar.</span></div>
    @if (Model.Result.Items.Count == 0)
    {
        <div class="ops-empty"><i data-lucide="search"></i><strong>Bu filtrelerle eşleşen sipariş yok</strong><p>Filtreleri değiştirerek diğer siparişlere ulaşabilirsiniz.</p><a class="secondary-action" asp-action="Orders">Tüm siparişleri göster</a></div>
    }
    else
    {
        <div class="ops-table-wrap"><table class="ops-orders-table" data-datatable="false"><caption class="visually-hidden">Filtrelenen siparişler ve operasyon durumları</caption><thead><tr><th>Sipariş / müşteri</th><th>Dönem ve durum</th><th>Kit hazırlığı</th><th>Adres ve kargo</th><th>Arıza / iade</th><th>İşlem</th></tr></thead><tbody>
        @foreach (var item in Model.Result.Items)
        {
            <partial name="_OperationsOrderRow" model="item" />
        }
        </tbody></table></div>
        <footer class="pagination-shell"><span>@first–@last / @Model.Result.TotalCount sipariş</span><nav class="pagination" aria-label="Sipariş sayfaları">
            @if (Model.Result.Page > 1) { <a asp-action="Orders" asp-all-route-data="PageRoute(Model.Result.Page - 1)" aria-label="Önceki sayfa">←</a> }
            @for (var pageNumber = Math.Max(1, Model.Result.Page - 2); pageNumber <= Math.Min(Model.Result.TotalPages, Model.Result.Page + 2); pageNumber++) { <a class="@(pageNumber == Model.Result.Page ? "active" : null)" aria-current="@(pageNumber == Model.Result.Page ? "page" : null)" asp-action="Orders" asp-all-route-data="PageRoute(pageNumber)">@pageNumber</a> }
            @if (Model.Result.Page < Model.Result.TotalPages) { <a asp-action="Orders" asp-all-route-data="PageRoute(Model.Result.Page + 1)" aria-label="Sonraki sayfa">→</a> }
        </nav></footer>
    }
</div>
@foreach (var item in Model.Result.Items.Where(item => canManageOrders && item.Type == 1 && !string.IsNullOrWhiteSpace(item.RentalPeriodName)))
{
    <partial name="_OrderPeriodDialog" model="item" />
}
