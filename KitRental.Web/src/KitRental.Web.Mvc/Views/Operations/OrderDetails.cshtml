@model OrderDetailViewModel
@{
    ViewData["Title"] = $"Sipariş {Model.OrderNumber}";
    var requestedCount = Model.Lines.Sum(line => line.Quantity);
    var allKitsCreated = Model.Kits.Count == requestedCount;
    var hasIncompleteStudentAddresses = Model.Students.Count > 0 && Model.Students.Any(student => string.IsNullOrWhiteSpace(student.AddressLine));
    var hasIncompleteStudentDeliveries = Model.Students.Count > 0 && Model.Students.Any(student => !student.IsDelivered);
    var canManage = User.IsInRole("SystemAdmin") || User.IsInRole("OperationsManager");
    var isPurchase = Model.Type == 2;
    var shipmentsByStudentId = Model.KargonomiShipments
        .GroupBy(shipment => shipment.StudentId)
        .ToDictionary(group => group.Key, group => group.OrderByDescending(shipment => shipment.UpdatedAt).First());
    var hasKitCreatableStudents = !isPurchase && canManage && Model.Status == 3 &&
        Model.Students.Any(student => !student.HasKitAssignment);
    string OrderStatus(int status) => status switch { 2 => "İnceleme / onay bekliyor", 3 => "Onaylandı", 4 => "Hazırlanıyor", 5 => "Kargoya hazır", 6 => "Kargoya verildi", 13 => "Tamamlandı", _ => "İşlemde" };
}
<div class="order-detail-heading">
    <div><a class="back-link" asp-action="Orders">← Siparişlere dön</a><span class="eyebrow">@(isPurchase ? "SATIN ALMA" : "KİRALAMA") · @Model.OrderNumber</span><h1>@Model.CustomerName</h1><p>@(isPurchase ? "Satın alma siparişi" : $"{Model.StartDate:dd.MM.yyyy} — {Model.EndDate:dd.MM.yyyy}")</p></div>
    <div class="order-detail-status"><span class="badge order-status-@Model.Status">@OrderStatus(Model.Status)</span><strong>@Model.Kits.Count / @requestedCount</strong><small>fiziksel kit oluşturuldu</small></div>
</div>
@if (TempData["Success"] is string success) { <div class="success-banner">@success</div> }
@if (TempData["Error"] is string error) { <div class="error-banner">@error</div> }

<section class="detail-section order-request-lines">
    <div class="section-heading"><div><span class="eyebrow">TALEP LİSTESİ</span><h2>İstenen kitler ve manuel oluşturma</h2><p>@(isPurchase ? "Hazır kitler önce ayrılır; eksik miktar bileşen stoktan üretilir." : "Fiziksel kitler öğrenci listesindeki seçimlerden oluşturulur ve rezerve edilir.")</p></div></div>
    <div class="order-line-cards">
    @foreach (var line in Model.Lines)
    {
        var remaining = line.Quantity - line.CreatedKitCount;
        <article class="@(remaining == 0 ? "complete" : null)">
            <div><span>@line.ProductSku</span><h3>@line.ProductName</h3><p>Talep: <b>@line.Quantity</b> · Oluşturulan: <b>@line.CreatedKitCount</b></p></div>
            @if (remaining == 0)
            {
                <span class="line-complete">✓ Tamamlandı</span>
            }
            else
            {
                <span class="line-pending">@remaining adet oluşturulacak</span>
            }
        </article>
    }
    </div>
</section>

@if (!isPurchase && Model.Students.Count > 0)
{
        <section class="detail-section" id="student-addresses">
        <div class="section-heading"><div><span class="eyebrow">ÖĞRENCİ VE KARGO LİSTESİ</span><h2>Öğrenciler ve gönderi durumları</h2></div><div class="heading-actions"><a class="secondary-action" asp-action="ExportOrderStudents" asp-route-id="@Model.Id">Excel Olarak İndir</a><a class="secondary-action" asp-action="ExportKargonomi" asp-route-id="@Model.Id">Kargonomi</a><a class="primary-action" asp-controller="PhysicalKits" asp-action="OrderLabels" asp-route-orderId="@Model.Id">QR Etiketlerini Yazdır</a></div></div>
        @if (canManage)
        {
            <form id="bulk-student-delete-form"
                  asp-action="DeleteOrderStudents"
                  asp-route-id="@Model.Id"
                  method="post"
                  hidden
                  data-confirm="Seçilen öğrenciler ve sipariş içindeki fiziksel kit bağlantıları silinsin mi?"
                  data-datatable-bulk-label="Sil"
                  data-datatable-bulk-class="dt-bulk-delete"></form>
            <form id="bulk-student-shipping-form"
                  asp-action="StartKargonomiShipments"
                  asp-route-id="@Model.Id"
                  method="post"
                  hidden
                  data-confirm="Seçilen uygun öğrencilerin kargo gönderileri başlatılsın mı?"
                  data-datatable-bulk-label="Kargoya Ver"
                  data-datatable-bulk-class="dt-bulk-shipping"
                  data-datatable-selection-attribute="canShip"
                  data-datatable-bulk-disabled-title="Seçilen kayıtların tamamında adres bulunmalı ve kargo işlemi başlatılabilir durumda olmalıdır."></form>
            @if (hasKitCreatableStudents)
            {
                <form id="bulk-student-kit-form"
                      asp-action="CreateSelectedOrderKits"
                      asp-route-id="@Model.Id"
                      method="post"
                      hidden
                      data-confirm="Seçilen öğrenciler için fiziksel kit oluşturulup rezerve edilsin mi?"
                      data-datatable-bulk-label="Kit Oluştur"
                      data-datatable-bulk-class="dt-bulk-kit"
                      data-datatable-selection-attribute="canCreateKit"
                      data-datatable-bulk-disabled-title="Sadece henüz fiziksel kit atanmamış öğrenciler seçilebilir."></form>
            }
        }
        <div class="table-scroll">
            <table class="order-kits-table student-order-table js-datatable"
                   data-datatable-responsive="false"
                   data-datatable-page-length="10"
                   data-datatable-column-filters="true"
                   data-datatable-select="@(canManage ? "multi" : "false")"
                   data-datatable-select-all-pages="true"
                   data-datatable-bulk-actions="bulk-student-delete-form,bulk-student-shipping-form,bulk-student-kit-form"
                   data-datatable-bulk-input="studentIds">
                <thead>
                    <tr><th><span class="visually-hidden">Seç</span></th><th>Öğrenci</th><th>Telefon</th><th>Fiziksel Kit</th><th>Kargo Durumu</th><th>Takip No</th><th>Adres</th><th>Adres Linki</th><th>İşlem</th></tr>
                    <tr class="column-filter-row" data-dt-order="disable">
                        <th></th>
                        <th><input type="search" data-column-filter aria-label="Öğrenci sütununu filtrele" placeholder="Öğrenci filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter aria-label="Telefon sütununu filtrele" placeholder="Telefon filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter aria-label="Fiziksel kit sütununu filtrele" placeholder="Kit filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter aria-label="Kargo durumu sütununu filtrele" placeholder="Durum filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter aria-label="Takip numarası sütununu filtrele" placeholder="Takip no filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter aria-label="Adres sütununu filtrele" placeholder="Adres filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter aria-label="Adres linki sütununu filtrele" placeholder="Adres linki filtrele" autocomplete="off" /></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var student in Model.Students)
                {
                    var addressUrl = Url.Action("Index", "PublicStudentAddress", new { token = student.PublicAddressToken }, Context.Request.Scheme) ?? string.Empty;
                    var hasAddress = !string.IsNullOrWhiteSpace(student.AddressLine);
                    shipmentsByStudentId.TryGetValue(student.Id, out var shipment);
                    var canStartShipment = canManage && hasAddress && (shipment is null || shipment.State == 6);
                    <tr data-select-value="@student.Id" data-can-ship="@canStartShipment.ToString().ToLowerInvariant()" data-can-create-kit="@((Model.Status == 3 && !student.HasKitAssignment).ToString().ToLowerInvariant())">
                        <td></td>
                        <td><strong class="student-name-truncate" title="@student.FullName">@student.FullName</strong></td>
                        <td>@student.GuardianPhone</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(student.AssignedKitSerialNumber))
                            {
                                <a class="student-kit-serial-truncate" title="@student.AssignedKitSerialNumber" asp-controller="PhysicalKits" asp-action="Details" asp-route-id="@student.AssignedKitId">@student.AssignedKitSerialNumber</a>
                            }
                            else
                            {
                                <span class="line-pending">Atanmadı</span>
                            }
                        </td>
                        <td>
                            @if (shipment is null)
                            {
                                <span class="line-pending">Başlatılmadı</span>
                            }
                            else if (shipment.State == 6)
                            {
                                <span class="line-pending">Hata</span>
                            }
                            else
                            {
                                <span class="line-complete">@shipment.StatusLabel</span>
                            }
                            @if (shipment is not null)
                            {
                                <small class="block-muted">@shipment.Carrier · @shipment.UpdatedAt.ToTurkeyTimeString("dd.MM.yyyy HH:mm")</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(shipment?.LastError))
                            {
                                <small class="block-muted" title="@shipment.LastError">@shipment.LastError</small>
                            }
                        </td>
                        <td>@(shipment?.TrackingNumber ?? "-")</td>
                        <td>
                            @if (hasAddress)
                            {
                                <span class="student-address-truncate" title="@student.AddressLine">@student.AddressLine</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(addressUrl))
                            {
                                <a class="student-public-link-truncate" href="@addressUrl" target="_blank" rel="noopener" title="@addressUrl">@addressUrl</a>
                            }
                        </td>
                        <td>
                            @if (canManage)
                            {
                                <div class="table-actions-compact student-shipment-actions">
                                    <form asp-action="DeleteOrderStudent" asp-route-id="@Model.Id" asp-route-studentId="@student.Id" method="post">
                                        <button class="icon-action icon-action-delete" type="submit" title="Öğrenciyi Sil" aria-label="@($"{student.FullName} öğrencisini sil")" data-confirm="@($"{student.FullName} öğrencisi ve bağlı fiziksel kiti siparişten silinsin mi?")">
                                            <i data-lucide="trash-2"></i><span class="visually-hidden">Sil</span>
                                        </button>
                                    </form>
                                    @if (canStartShipment)
                                    {
                                        <form asp-action="StartKargonomiShipments" asp-route-id="@Model.Id" method="post">
                                            <input type="hidden" name="studentIds" value="@student.Id" />
                                            <button class="icon-action icon-action-shipping" type="submit" title="Kargoya Ver" aria-label="@($"{student.FullName} öğrencisini kargoya ver")" data-confirm="@($"{student.FullName} öğrencisinin kargo gönderisi başlatılsın mı?")">
                                                <i data-lucide="truck"></i><span class="visually-hidden">Kargoya Ver</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        var shipmentActionTitle = !hasAddress
                                            ? "Öğrenci adresi tamamlanmadan kargoya verilemez."
                                            : "Bu öğrenci için kargo gönderisi zaten başlatıldı.";
                                        <button class="icon-action icon-action-shipping" type="button" disabled aria-disabled="true" title="@shipmentActionTitle" aria-label="@($"{student.FullName} öğrencisini kargoya ver")">
                                            <i data-lucide="truck"></i><span class="visually-hidden">Kargoya Ver</span>
                                        </button>
                                    }
                                </div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@if (canManage && Model.Status == 2)
{
    <div class="order-detail-next"><p>Siparişi inceledikten sonra fiziksel kit oluşturma adımı açılır.</p><form asp-action="UpdateOrderStatus" asp-route-id="@Model.Id" method="post"><input type="hidden" name="target" value="3" /><input type="hidden" name="returnToDetails" value="true" /><button class="primary-action" type="submit">Siparişi Onayla →</button></form></div>
}
else if (canManage && (Model.Status is 3 or 4 or 5 or 6 or 7) && allKitsCreated)
{
    <div class="order-detail-next">
        <p>@(hasIncompleteStudentDeliveries ? "Siparişi tamamlamak için siparişteki tüm öğrencilerin kitleri teslim edilmiş olmalıdır." : isPurchase ? "Tüm fiziksel kitler rezerve edildi; tamamlandığında kitler satıldı durumuna alınır." : "Tüm fiziksel kitler oluşturuldu ve öğrencilere teslim edildi; kit konumları güncellendi.")</p>
        @if (hasIncompleteStudentDeliveries)
        {
            <button class="primary-action" type="button" data-inline-error="Teslim edilmemiş öğrenci kitleri var, önce teslim durumlarını güncelleyin.">Siparişi Tamamla →</button>
        }
        else
        {
            <form asp-action="UpdateOrderStatus" asp-route-id="@Model.Id" method="post"><input type="hidden" name="target" value="13" /><input type="hidden" name="returnToDetails" value="true" /><button class="primary-action" type="submit">Siparişi Tamamla →</button></form>
        }
    </div>
}
