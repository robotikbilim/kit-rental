@model OrderDetailViewModel
@functions {
    static IReadOnlyCollection<int> PaginationPages(int currentPage, int totalPages)
    {
        var start = Math.Max(1, currentPage - 2);
        var end = Math.Min(totalPages, currentPage + 2);
        return Enumerable.Range(start, end - start + 1).ToArray();
    }
}
@{
    ViewData["Title"] = $"Sipariş {Model.OrderNumber}";
    var requestedCount = Model.Lines.Sum(line => line.Quantity);
    var allKitsCreated = Model.Kits.Count == requestedCount;
    var hasIncompleteStudentAddresses = Model.Students.Count > 0 && Model.Students.Any(student => string.IsNullOrWhiteSpace(student.AddressLine));
    var hasIncompleteStudentDeliveries = Model.Students.Count > 0 && Model.Students.Any(student => !student.IsDelivered);
    var canManage = User.IsInRole("SystemAdmin") || User.IsInRole("OperationsManager");
    const int orderDetailPageSize = 10;
    var addressState = Context.Request.Query["addressState"].ToString().Trim().ToLowerInvariant();
    if (addressState is not ("completed" or "pending")) addressState = string.Empty;
    var deliveryState = Context.Request.Query["deliveryState"].ToString().Trim().ToLowerInvariant();
    if (deliveryState is not ("delivered" or "pending")) deliveryState = string.Empty;
    IEnumerable<OrderDetailStudentViewModel> filteredStudents = Model.Students;
    if (addressState == "completed") filteredStudents = filteredStudents.Where(student => !string.IsNullOrWhiteSpace(student.AddressLine));
    if (addressState == "pending") filteredStudents = filteredStudents.Where(student => string.IsNullOrWhiteSpace(student.AddressLine));
    if (deliveryState == "delivered") filteredStudents = filteredStudents.Where(student => student.IsDelivered);
    if (deliveryState == "pending") filteredStudents = filteredStudents.Where(student => !student.IsDelivered);
    var filteredStudentList = filteredStudents.ToArray();
    int ReadPositivePage(string key) =>
        int.TryParse(Context.Request.Query[key].ToString(), out var value) && value > 0 ? value : 1;
    var studentTotalCount = filteredStudentList.Length;
    var studentTotalPages = Math.Max(1, (int)Math.Ceiling(studentTotalCount / (double)orderDetailPageSize));
    var studentPage = Math.Min(ReadPositivePage("studentPage"), studentTotalPages);
    var studentFirstItem = studentTotalCount == 0 ? 0 : (studentPage - 1) * orderDetailPageSize + 1;
    var studentLastItem = Math.Min(studentPage * orderDetailPageSize, studentTotalCount);
    var pagedStudents = filteredStudentList.Skip((studentPage - 1) * orderDetailPageSize).Take(orderDetailPageSize).ToArray();
    string OrderStatus(int status) => status switch { 2 => "İnceleme / onay bekliyor", 3 => "Onaylandı", 4 => "Hazırlanıyor", 5 => "Kargoya hazır", 6 => "Kargoya verildi", 13 => "Tamamlandı", _ => "İşlemde" };
    var isPurchase = Model.Type == 2;
}
<div class="order-detail-heading">
    <div><a class="back-link" asp-action="Orders">← Siparişlere dön</a><span class="eyebrow">@(isPurchase ? "SATIN ALMA" : "KİRALAMA") · @Model.OrderNumber</span><h1>@Model.CustomerName</h1><p>@(isPurchase ? "Satın alma siparişi" : $"{Model.StartDate:dd.MM.yyyy} — {Model.EndDate:dd.MM.yyyy}")</p></div>
    <div class="order-detail-status"><span class="badge order-status-@Model.Status">@OrderStatus(Model.Status)</span><strong>@Model.Kits.Count / @requestedCount</strong><small>fiziksel kit oluşturuldu</small></div>
</div>
@if (TempData["Success"] is string success) { <div class="success-banner">@success</div> }
@if (TempData["Error"] is string error) { <div class="error-banner">@error</div> }

<section class="detail-section order-request-lines">
    <div class="section-heading"><div><span class="eyebrow">TALEP LİSTESİ</span><h2>İstenen kitler ve manuel oluşturma</h2><p>@(isPurchase ? "Hazır kitler önce ayrılır; eksik miktar bileşen stoktan üretilir." : "Ürün ve adetleri düzenleyin; siparişin fiziksel kitleri rezerve edilir.")</p></div>@if (canManage && Model.Status == 3 && Model.Kits.Count == 0) { <a class="primary-action" asp-action="PrepareOrderKits" asp-route-id="@Model.Id">Kitleri Oluştur Ve Rezerve Et →</a> }</div>
    <div class="order-line-cards">
    @foreach (var line in Model.Lines)
    {
        var remaining = line.Quantity - line.CreatedKitCount;
        <article class="@(remaining == 0 ? "complete" : null)">
            <div><span>@line.ProductSku</span><h3>@line.ProductName</h3><p>Talep: <b>@line.Quantity</b> · Oluşturulan: <b>@line.CreatedKitCount</b></p></div>
            @if (remaining == 0)
            {
                <span class="line-complete">✓ Tamamlandı</span>
            }
            else
            {
                <span class="line-pending">@remaining adet oluşturulacak</span>
            }
        </article>
    }
    </div>
</section>

@if (!isPurchase && Model.Students.Count > 0)
{
        <section class="detail-section" id="student-addresses">
        <div class="section-heading"><div><span class="eyebrow">ÖĞRENCİ LİSTESİ</span></div><div class="heading-actions"><a class="secondary-action" asp-action="ExportOrderStudents" asp-route-id="@Model.Id">Excel Olarak İndir</a><a class="primary-action" asp-controller="PhysicalKits" asp-action="OrderLabels" asp-route-orderId="@Model.Id">QR Etiketlerini Yazdır</a></div></div>
        <form method="get" class="portal-kit-filters student-list-filters" data-auto-filter="true">
            <input type="hidden" name="id" value="@Model.Id" />
            <label><span>Adres Durumu</span><select name="addressState"><option value="">Tümü</option><option value="completed" selected="@(addressState == "completed")">Adres Girilmiş</option><option value="pending" selected="@(addressState == "pending")">Adres Bekleniyor</option></select></label>
            <label><span>Teslim Durumu</span><select name="deliveryState"><option value="">Tümü</option><option value="delivered" selected="@(deliveryState == "delivered")">Teslim Edildi</option><option value="pending" selected="@(deliveryState == "pending")">Teslim Bekleniyor</option></select></label>
        </form>
        <form id="bulk-student-delivery-form" asp-action="ConfirmStudentDeliveries" asp-route-id="@Model.Id" method="post">
            <div class="bulk-selection-bar">
                <label><input id="select-all-students" type="checkbox" aria-label="Bu sayfadaki tüm öğrencileri seç" /> Bu sayfadaki tümünü seç</label>
                @foreach (var student in filteredStudentList.Where(student => !student.IsDelivered && !string.IsNullOrWhiteSpace(student.AddressLine) && student.HasKitAssignment))
                {
                    <input class="filtered-student-selection" type="hidden" name="studentIds" value="@student.Id" disabled />
                }
                @if (filteredStudentList.Any(student => !student.IsDelivered && !string.IsNullOrWhiteSpace(student.AddressLine) && student.HasKitAssignment))
                {
                    <button class="bulk-select-filtered" id="select-all-filtered-students" type="button">Filtreye uyan tüm uygun öğrencileri seç</button>
                }
                <button class="primary-action" id="bulk-student-delivery-button" type="submit" disabled data-confirm="Seçilen öğrenciler teslim edildi olarak işaretlensin mi?">Seçilenleri Teslim Edildi İşaretle</button>
            </div>
        </form>
        <div class="table-scroll">
            <table class="order-kits-table student-order-table">
                <thead><tr><th><span class="visually-hidden">Seç</span></th><th>Öğrenci</th><th>Telefon</th><th>Adres Durumu</th><th>Teslim Durumu</th><th>Fiziksel Kit</th><th>Adres</th><th>Public Link</th><th></th></tr></thead>
                <tbody>
                @foreach (var student in pagedStudents)
                {
                    var addressUrl = Url.Action("Index", "PublicStudentAddress", new { token = student.PublicAddressToken }, Context.Request.Scheme) ?? string.Empty;
                    var hasAddress = !string.IsNullOrWhiteSpace(student.AddressLine);
                    <tr>
                        <td><input class="student-selection" form="bulk-student-delivery-form" type="checkbox" name="studentIds" value="@student.Id" aria-label="@student.FullName öğrencisini seç" @(student.IsDelivered || !hasAddress || !student.HasKitAssignment ? "disabled" : null) /></td>
                        <td><strong>@student.FullName</strong></td>
                        <td>@student.GuardianPhone</td>
                        <td>@if (hasAddress) { <span class="line-complete">✓ Tamamlandı</span> } else { <span class="line-pending">Bekleniyor</span> }</td>
                        <td>
                            @if (student.IsDelivered)
                            {
                                <span class="line-complete">✓ Teslim Edildi</span>
                            }
                            else
                            {
                                <span class="line-pending">Teslim Edilmedi</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(student.AssignedKitSerialNumber))
                            {
                                <a class="row-link" asp-controller="PhysicalKits" asp-action="Details" asp-route-id="@student.AssignedKitId">Kite Git</a>
                            }
                            else
                            {
                                <span class="line-pending">Atanmadı</span>
                            }
                        </td>
                        <td>
                            @if (hasAddress)
                            {
                                <div class="table-actions-compact">
                                    <button class="row-link" type="button" data-fulltext-modal data-title="@($"{student.FullName} adresi")" data-text="@student.AddressLine">Göster</button>
                                </div>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(addressUrl))
                            {
                                <div class="table-actions-compact">
                                    <button class="row-link" type="button" data-fulltext-modal data-title="@($"{student.FullName} public adres linki")" data-text="@addressUrl">Göster</button>
                                </div>
                            }
                        </td>
                        <td>
                            @if (canManage)
                            {
                                <form asp-action="DeleteOrderStudent" asp-route-id="@Model.Id" asp-route-studentId="@student.Id" method="post">
                                    <button class="row-link row-link-danger" type="submit" data-confirm="@($"{student.FullName} öğrencisi ve bağlı fiziksel kiti siparişten silinsin mi?")">Sil</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <footer class="pagination-shell">
            <span>@studentFirstItem–@studentLastItem / @studentTotalCount öğrenci</span>
            @if (studentTotalPages > 1)
            {
                <nav class="pagination" aria-label="Öğrenci adresleri sayfaları">
                    @if (studentPage > 1) { <a asp-action="OrderDetails" asp-route-id="@Model.Id" asp-route-studentPage="@(studentPage - 1)" asp-route-addressState="@addressState" asp-route-deliveryState="@deliveryState" asp-fragment="student-addresses">←</a> }
                    @foreach (var pageNumber in PaginationPages(studentPage, studentTotalPages)) { <a class="@(pageNumber == studentPage ? "active" : null)" aria-current="@(pageNumber == studentPage ? "page" : null)" asp-action="OrderDetails" asp-route-id="@Model.Id" asp-route-studentPage="@pageNumber" asp-route-addressState="@addressState" asp-route-deliveryState="@deliveryState" asp-fragment="student-addresses">@pageNumber</a> }
                    @if (studentPage < studentTotalPages) { <a asp-action="OrderDetails" asp-route-id="@Model.Id" asp-route-studentPage="@(studentPage + 1)" asp-route-addressState="@addressState" asp-route-deliveryState="@deliveryState" asp-fragment="student-addresses">→</a> }
                </nav>
            }
        </footer>
        <script>
            (() => {
                const selectAll = document.querySelector('#select-all-students');
                const boxes = [...document.querySelectorAll('.student-selection')];
                const filteredBoxes = [...document.querySelectorAll('.filtered-student-selection')];
                const selectAllFiltered = document.querySelector('#select-all-filtered-students');
                const button = document.querySelector('#bulk-student-delivery-button');
                let allFilteredSelected = false;
                const update = () => {
                    const selectable = boxes.filter(box => !box.disabled);
                    const selected = selectable.filter(box => box.checked).length;
                    if (button) button.disabled = !allFilteredSelected && selected === 0;
                    if (selectAll) selectAll.checked = selectable.length > 0 && selected === selectable.length;
                };
                selectAll?.addEventListener('change', () => {
                    allFilteredSelected = false;
                    filteredBoxes.forEach(box => box.disabled = true);
                    boxes.forEach(box => { if (!box.disabled) box.checked = selectAll.checked; });
                    if (selectAllFiltered) selectAllFiltered.textContent = 'Filtreye uyan tüm uygun öğrencileri seç';
                    update();
                });
                selectAllFiltered?.addEventListener('click', () => {
                    allFilteredSelected = !allFilteredSelected;
                    filteredBoxes.forEach(box => box.disabled = !allFilteredSelected);
                    boxes.forEach(box => { if (!box.disabled) box.checked = false; });
                    selectAll.checked = false;
                    selectAllFiltered.textContent = allFilteredSelected ? 'Tüm filtre seçimini kaldır' : 'Filtreye uyan tüm uygun öğrencileri seç';
                    update();
                });
                boxes.forEach(box => box.addEventListener('change', update));
                update();
            })();
        </script>
    </section>
}

@if (canManage && Model.Status == 2)
{
    <div class="order-detail-next"><p>Siparişi inceledikten sonra fiziksel kit oluşturma adımı açılır.</p><form asp-action="UpdateOrderStatus" asp-route-id="@Model.Id" method="post"><input type="hidden" name="target" value="3" /><input type="hidden" name="returnToDetails" value="true" /><button class="primary-action" type="submit">Siparişi Onayla →</button></form></div>
}
else if (canManage && (Model.Status is 3 or 4 or 5 or 6 or 7) && allKitsCreated)
{
    <div class="order-detail-next">
        <p>@(hasIncompleteStudentDeliveries ? "Siparişi tamamlamak için siparişteki tüm öğrencilerin kitleri teslim edilmiş olmalıdır." : isPurchase ? "Tüm fiziksel kitler rezerve edildi; tamamlandığında kitler satıldı durumuna alınır." : "Tüm fiziksel kitler oluşturuldu ve öğrencilere teslim edildi; kit konumları güncellendi.")</p>
        @if (hasIncompleteStudentDeliveries)
        {
            <button class="primary-action" type="button" data-inline-error="Teslim edilmemiş öğrenci kitleri var, önce teslim durumlarını güncelleyin.">Siparişi Tamamla →</button>
        }
        else
        {
            <form asp-action="UpdateOrderStatus" asp-route-id="@Model.Id" method="post"><input type="hidden" name="target" value="13" /><input type="hidden" name="returnToDetails" value="true" /><button class="primary-action" type="submit">Siparişi Tamamla →</button></form>
        }
    </div>
}
