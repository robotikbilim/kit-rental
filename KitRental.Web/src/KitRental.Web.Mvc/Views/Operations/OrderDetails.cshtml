@model OrderDetailViewModel
@{
    ViewData["Title"] = $"Sipariş {Model.OrderNumber}";
    var requestedCount = Model.Lines.Sum(line => line.Quantity);
    var allKitsCreated = Model.Kits.Count == requestedCount;
    var hasIncompleteStudentAddresses = Model.Students.Count > 0 && Model.Students.Any(student => !student.HasAddress);
    var canManage = User.IsInRole("SystemAdmin") || User.IsInRole("OperationsManager");
    string OrderStatus(int status) => status switch { 2 => "İnceleme / onay bekliyor", 3 => "Onaylandı", 4 => "Hazırlanıyor", 5 => "Kargoya hazır", 6 => "Kargoya verildi", 13 => "Tamamlandı", _ => "İşlemde" };
    string KitStatus(int status) => status switch { 2 => "Rezerve", 3 => "Gönderim bekliyor", 4 => "Kargoya verildi", 5 => "Teslim edildi / kirada", 12 => "Satıldı", _ => "Hazırlanıyor" };
    var isPurchase = Model.Type == 2;
}
<div class="order-detail-heading">
    <div><a class="back-link" asp-action="Orders">← Siparişlere dön</a><span class="eyebrow">@(isPurchase ? "SATIN ALMA" : "KİRALAMA") · @Model.OrderNumber</span><h1>@Model.CustomerName</h1><p>@(isPurchase ? "Satın alma siparişi" : $"{Model.StartDate:dd.MM.yyyy} — {Model.EndDate:dd.MM.yyyy}")</p></div>
    <div class="order-detail-status"><span class="badge order-status-@Model.Status">@OrderStatus(Model.Status)</span><strong>@Model.Kits.Count / @requestedCount</strong><small>fiziksel kit oluşturuldu</small></div>
</div>
@if (TempData["Success"] is string success) { <div class="success-banner">@success</div> }
@if (TempData["Error"] is string error) { <div class="error-banner">@error</div> }

<section class="detail-section order-request-lines">
    <div class="section-heading"><div><span class="eyebrow">TALEP LİSTESİ</span><h2>İstenen kitler ve manuel oluşturma</h2><p>@(isPurchase ? "Hazır kitler önce ayrılır; eksik miktar bileşen stoktan üretilir." : "Ürün ve adetleri düzenleyin; siparişin fiziksel kitleri rezerve edilir.")</p></div>@if (canManage && Model.Status == 3 && Model.Kits.Count == 0) { <a class="primary-action" asp-action="PrepareOrderKits" asp-route-id="@Model.Id">Kitleri Oluştur Ve Rezerve Et →</a> }</div>
    @if (hasIncompleteStudentAddresses)
    {
        <div class="success-banner">Adresi eksik öğrenciler için de kit oluşturma ve atama yapılabilir; sipariş tamamlanmadan önce tüm öğrenci adresleri girilmiş olmalıdır.</div>
    }
    <div class="order-line-cards">
    @foreach (var line in Model.Lines)
    {
        var remaining = line.Quantity - line.CreatedKitCount;
        <article class="@(remaining == 0 ? "complete" : null)">
            <div><span>@line.ProductSku</span><h3>@line.ProductName</h3><p>Talep: <b>@line.Quantity</b> · Oluşturulan: <b>@line.CreatedKitCount</b></p></div>
            @if (remaining == 0)
            {
                <span class="line-complete">✓ Tamamlandı</span>
            }
            else
            {
                <span class="line-pending">@remaining adet oluşturulacak</span>
            }
        </article>
    }
    </div>
</section>

@if (!isPurchase && Model.Students.Count > 0)
{
    <section class="detail-section">
        <div class="section-heading"><div><span class="eyebrow">ÖĞRENCİ ADRESLERİ</span><h2>Public adres toplama linkleri</h2><p>Her öğrenciye kendi linkini gönderin; adres geldiğinde bu tabloda görünür.</p></div><a class="secondary-action" asp-action="ExportOrderStudents" asp-route-id="@Model.Id">Excel Olarak İndir</a></div>
        <div class="table-scroll">
            <table class="order-kits-table">
                <thead><tr><th>Öğrenci</th><th>Telefon</th><th>Adres Durumu</th><th>Adres</th><th>Public Link</th></tr></thead>
                <tbody>
                @foreach (var student in Model.Students)
                {
                    var addressUrl = Url.Action("Index", "PublicStudentAddress", new { token = student.PublicAddressToken }, Context.Request.Scheme) ?? string.Empty;
                    <tr>
                        <td><strong>@student.FullName</strong></td>
                        <td>@student.GuardianPhone</td>
                        <td>@if (student.HasAddress) { <span class="line-complete">✓ Tamamlandı</span> } else { <span class="line-pending">Bekleniyor</span> }</td>
                        <td>
                            @if (student.HasAddress)
                            {
                                <div class="table-actions-compact">
                                    <button class="row-link" type="button" data-fulltext-modal data-title="@($"{student.FullName} adresi")" data-text="@student.AddressLine">Göster</button>
                                </div>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(addressUrl))
                            {
                                <div class="table-actions-compact">
                                    <button class="row-link copy-address-link" type="button" data-link="@addressUrl">Kopyala</button>
                                    <button class="row-link" type="button" data-fulltext-modal data-title="@($"{student.FullName} public adres linki")" data-text="@addressUrl">Göster</button>
                                </div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@if (canManage && Model.Status == 2)
{
    <div class="order-detail-next"><p>Siparişi inceledikten sonra fiziksel kit oluşturma adımı açılır.</p><form asp-action="UpdateOrderStatus" asp-route-id="@Model.Id" method="post"><input type="hidden" name="target" value="3" /><input type="hidden" name="returnToDetails" value="true" /><button class="primary-action" type="submit">Siparişi Onayla →</button></form></div>
}
else if (canManage && (Model.Status is 3 or 4 or 5 or 6 or 7) && allKitsCreated)
{
    <div class="order-detail-next">
        <p>@(hasIncompleteStudentAddresses ? "Siparişi tamamlamak için siparişteki tüm öğrencilerin adres bilgileri girilmiş olmalıdır." : isPurchase ? "Tüm fiziksel kitler rezerve edildi; tamamlandığında kitler satıldı durumuna alınır." : "Tüm fiziksel kitler oluşturuldu ve öğrencilere rezerve edildi; tamamlandığında öğrenci adresleri kit konum geçmişine işlenir.")</p>
        @if (hasIncompleteStudentAddresses)
        {
            <button class="primary-action" type="button" disabled>Siparişi Tamamla →</button>
        }
        else
        {
            <form asp-action="UpdateOrderStatus" asp-route-id="@Model.Id" method="post"><input type="hidden" name="target" value="13" /><input type="hidden" name="returnToDetails" value="true" /><button class="primary-action" type="submit">Siparişi Tamamla →</button></form>
        }
    </div>
}

<section class="detail-section">
    <div class="section-heading"><div><span class="eyebrow">SİPARİŞE BAĞLI FİZİKSEL KİTLER</span><h2>Seri numaraları ve QR kodları</h2></div>@if (Model.Kits.Count > 0) { <a class="primary-action" asp-controller="PhysicalKits" asp-action="OrderLabels" asp-route-orderId="@Model.Id">QR Etiketlerini Yazdır</a> }</div>
    @if (Model.Kits.Count == 0)
    {
        <div class="empty">Bu sipariş için henüz fiziksel kit oluşturulmadı.</div>
    }
    else
    {
        <div class="table-scroll"><table class="order-kits-table"><thead><tr><th>Kit</th><th>Seri numarası</th><th>QR kod</th><th>Durum</th><th></th></tr></thead><tbody>@foreach (var kit in Model.Kits) { <tr><td><strong>@kit.ProductName</strong><small class="block-muted">@kit.ProductSku</small></td><td><code class="unit-serial">@kit.SerialNumber</code></td><td><span class="unit-qr">@kit.QrCode</span></td><td><span class="fleet-status status-@kit.Status">@KitStatus(kit.Status)</span></td><td><a class="row-link" asp-controller="PhysicalKits" asp-action="Details" asp-route-id="@kit.Id">Kit Detayı →</a></td></tr> }</tbody></table></div>
    }
</section>
