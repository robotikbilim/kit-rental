@model DashboardViewModel
@{
    ViewData["Title"] = "Genel Bakış";
    var urgentWorkCount = Model is null ? 0 :
        Model.OrdersAwaitingApproval + Model.FaultyKits + Model.ExpiredRentalKits.Count + Model.ReturnsInProgress.Count;
}
<div class="page-heading dashboard-heading">
    <div><span class="eyebrow">CANLI OPERASYON</span><h1>Bugün neyle ilgilenmelisiniz?</h1><p>Tüm kritik işleri önem sırasına göre tek ekrandan yönetin.</p></div>
    <span class="status-dot"><partial name="_DashboardIcon" model="@("status")" /> Sistem çalışıyor</span>
</div>
@if (Model is null)
{
    <div class="empty">Core servisine ulaşılamadı.</div>
}
else
{
    @if (TempData["Success"] is string success) { <div class="alert success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert error">@error</div> }
    <section class="attention-board">
        <header class="attention-heading">
            <div><span class="eyebrow">ÖNCELİKLİ İŞLER</span><h2>@(urgentWorkCount == 0 ? "Harika, bekleyen kritik iş yok" : $"{urgentWorkCount} iş sizi bekliyor")</h2></div>
            <span class="attention-pulse">Canlı durum</span>
        </header>
        <div class="attention-grid">
            <a class="attention-card priority-high" asp-action="Orders">
                <span class="attention-icon"><partial name="_DashboardIcon" model="@("orders")" /></span><div><small>SİPARİŞ ONAYI</small><strong>@Model.OrdersAwaitingApproval</strong><p>Onayınızı bekleyen sipariş</p></div><b>İncele →</b>
            </a>
            <a class="attention-card priority-high" asp-action="Faults">
                <span class="attention-icon"><partial name="_DashboardIcon" model="@("fault")" /></span><div><small>TEKNİK SERVİS</small><strong>@Model.FaultyKits</strong><p>İlgilenilmesi gereken arıza</p></div><b>Arızalara git →</b>
            </a>
            <a class="attention-card priority-medium" asp-action="Dashboard" asp-fragment="expired-rentals">
                <span class="attention-icon"><partial name="_DashboardIcon" model="@("clock")" /></span><div><small>GECİKEN İADE</small><strong>@Model.ExpiredRentalKits.Count</strong><p>Süresi dolan kiralık kit</p></div><b>Listeyi aç →</b>
            </a>
            <a class="attention-card priority-medium" asp-action="Dashboard" asp-fragment="returns">
                <span class="attention-icon"><partial name="_DashboardIcon" model="@("return")" /></span><div><small>GELEN TESLİMAT</small><strong>@Model.ReturnsInProgress.Count</strong><p>Devam eden müşteri iadesi</p></div><b>Kontrol et →</b>
            </a>
        </div>
    </section>
    <nav class="dashboard-shortcuts" aria-label="Hızlı işlemler">
        @if (User.IsInRole("SystemAdmin") || User.IsInRole("OperationsManager"))
        {
            <a asp-action="CreateOrder"><partial name="_DashboardIcon" model="@("plus")" />Yeni sipariş</a>
        }
        <a asp-controller="PhysicalKits" asp-action="Lookup"><partial name="_DashboardIcon" model="@("scan")" />Kit sorgula</a>
        <a asp-controller="Workshop" asp-action="Index"><partial name="_DashboardIcon" model="@("search")" />Komponent bul</a>
        <a asp-action="Inventory"><partial name="_DashboardIcon" model="@("inventory")" />Envanteri aç</a>
        <a asp-controller="SupplyNeeds" asp-action="Index"><partial name="_DashboardIcon" model="@("list")" />İhtiyaç listeleri</a>
    </nav>
    <section class="dashboard-group dashboard-group-general">
        <header class="dashboard-group-heading">
            <div><span class="eyebrow">GÜNLÜK OPERASYON</span><h2>Genel hızlı erişimler</h2></div>
            <p>Bekleyen işleri ve hareket halindeki kitleri tek bakışta takip edin.</p>
        </header>
        <div class="metrics dashboard-metrics">
            <a class="metric-card" asp-action="Orders"><span>Onay bekleyen sipariş</span><strong>@Model.OrdersAwaitingApproval</strong><small>Siparişlere git →</small></a>
            <a class="metric-card" asp-action="Orders"><span>Aktif sipariş</span><strong>@Model.ActiveOrders</strong><small>Siparişlere git →</small></a>
            <a class="metric-card" asp-action="Inventory" asp-route-status="3"><span>Hazırlanıyor</span><strong>@Model.PreparingKits</strong><small>Hazırlanan kitlere git →</small></a>
            <a class="metric-card" asp-action="Inventory"><span>Kargodaki kit</span><strong>@Model.KitsInTransit</strong><small>Envantere git →</small></a>
        </div>
    </section>

    <section class="dashboard-group dashboard-group-rentals" id="expired-rentals">
        <header class="dashboard-group-heading">
            <div><span class="eyebrow">KİRALAMA TAKİBİ</span><h2>Süresi dolan ve yaklaşan kitler</h2></div>
            <p>Müşterideki aktif kitlerin teslim tarihlerini takip edin. Yaklaşan listesi önümüzdeki 7 günü kapsar.</p>
        </header>
        <div class="metrics dashboard-metrics">
            <div class="metric-card metric-fault"><span>Süresi dolan kit</span><strong>@Model.ExpiredRentalKits.Count</strong><small>İade süreci başlatılmalı</small></div>
            <div class="metric-card metric-repaired"><span>Süresi yaklaşan kit</span><strong>@Model.ExpiringRentalKits.Count</strong><small>7 gün içinde bitecek</small></div>
        </div>

        <h3>Süresi dolan kiralık kitler</h3>
        @if (Model.ExpiredRentalKits.Count == 0) { <div class="empty">Süresi dolmuş kiralık kit bulunmuyor.</div> }
        else { <div class="table-wrap"><table><thead><tr><th>Kit</th><th>Seri no</th><th>Müşteri</th><th>Sipariş</th><th>Bitiş tarihi</th><th>Gecikme</th></tr></thead><tbody>
        @foreach (var item in Model.ExpiredRentalKits) { <tr><td>@item.KitName</td><td>@item.SerialNumber</td><td>@item.CustomerName</td><td>@item.OrderNumber</td><td>@item.EndDate.ToString("dd.MM.yyyy")</td><td><span class="status-badge danger">@(-item.DaysRemaining) gün geçti</span></td></tr> }
        </tbody></table></div> }

        <h3>Süresi yaklaşan kiralık kitler</h3>
        @if (Model.ExpiringRentalKits.Count == 0) { <div class="empty">Önümüzdeki 7 gün içinde süresi dolacak kit bulunmuyor.</div> }
        else { <div class="table-wrap"><table><thead><tr><th>Kit</th><th>Seri no</th><th>Müşteri</th><th>Sipariş</th><th>Bitiş tarihi</th><th>Kalan</th></tr></thead><tbody>
        @foreach (var item in Model.ExpiringRentalKits) { <tr><td>@item.KitName</td><td>@item.SerialNumber</td><td>@item.CustomerName</td><td>@item.OrderNumber</td><td>@item.EndDate.ToString("dd.MM.yyyy")</td><td><span class="status-badge warning">@(item.DaysRemaining == 0 ? "Bugün" : $"{item.DaysRemaining} gün")</span></td></tr> }
        </tbody></table></div> }
    </section>

    <section class="dashboard-group" id="returns">
        <header class="dashboard-group-heading"><div><span class="eyebrow">MUSTERI IADELERI</span><h2>Teslimat surecindeki kitler</h2></div><p>Musterinin baslattigi iadeleri, talep eden kisiyi ve konumu izleyin.</p></header>
        @if (Model.ReturnsInProgress.Count == 0) { <div class="empty">Devam eden kit iadesi bulunmuyor.</div> }
        else { <div class="table-wrap"><table><thead><tr><th>Musteri</th><th>Talep eden</th><th>Kit sayisi</th><th>Durum</th><th>Konum</th><th>Kargo</th><th>Baslatilma</th><th></th></tr></thead><tbody>
        @foreach (var item in Model.ReturnsInProgress) { var requester = string.Join(" ", new[] { item.RequesterFirstName, item.RequesterLastName }.Where(x => !string.IsNullOrWhiteSpace(x))); var mapUrl = item.Latitude.HasValue && item.Longitude.HasValue ? $"https://www.google.com/maps?q={item.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{item.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}" : null; <tr><td>@item.CustomerName</td><td>@(string.IsNullOrWhiteSpace(requester) ? "-" : requester)@if (!string.IsNullOrWhiteSpace(item.RequesterPhone)) { <a class="fault-phone" href="tel:@item.RequesterPhone">@item.RequesterPhone</a> }</td><td>@item.KitCount</td><td>@(item.Status == 1 ? "Kargo bekleniyor" : "Iade kargoda")</td><td>@if (mapUrl is null) { <span>-</span> } else { <a class="table-action" href="@mapUrl" target="_blank" rel="noopener">Haritada ac</a> }</td><td>@(item.Carrier is null ? "-" : $"{item.Carrier} / {item.TrackingNumber}")</td><td>@item.CreatedAt.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td><td>@if (item.Status == 2) { <form asp-action="ReceiveReturn" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Kitlerin elinize ulastigini ve kullanilabilir stoka alinacagini onayliyor musunuz?');"><button class="btn btn-primary" type="submit">Teslim aldim</button></form> }</td></tr> }
        </tbody></table></div> }
    </section>

    <section class="dashboard-group dashboard-group-faults">
        <header class="dashboard-group-heading">
            <div><span class="eyebrow">TEKNİK SERVİS</span><h2>Arızalı kit hızlı gösterimleri</h2></div>
            <p>Arıza, bakım ve yeniden gönderim bekleyen kitlerin güncel özeti.</p>
        </header>
        <div class="metrics dashboard-metrics">
            <a class="metric-card metric-fault" asp-action="Faults"><span>Arızalı kit</span><strong>@Model.FaultyKits</strong><small>Arızalara git →</small></a>
            <a class="metric-card metric-fault" asp-action="Inventory"><span>Bakımda</span><strong>@Model.UnitsInMaintenance</strong><small>Envantere git →</small></a>
            <a class="metric-card metric-repaired" asp-action="Faults"><span>Onarıldı, kargo bekliyor</span><strong>@Model.RepairedAwaitingShipment</strong><small>Arıza geçmişine git →</small></a>
        </div>
    </section>

    <section class="dashboard-group dashboard-group-reports">
        <header class="dashboard-group-heading">
            <div><span class="eyebrow">FİLO ÖZETİ</span><h2>Rapor amaçlı gösterimler</h2></div>
            <p>Kit kapasitesi ve müşteri portföyünün genel görünümü.</p>
        </header>
        <div class="metrics dashboard-metrics">
            <a class="metric-card metric-rented" asp-action="Inventory" asp-route-status="5"><span>Şu anda kirada</span><strong>@Model.RentedKits</strong><small>Kiradaki kitlere git →</small></a>
            <a class="metric-card metric-available" asp-action="Inventory" asp-route-status="1"><span>Kiralanabilir kit</span><strong>@Model.AvailableKits</strong><small>Hazır kitlere git →</small></a>
            <a class="metric-card" asp-action="Inventory"><span>Toplam fiziksel kit</span><strong>@Model.ProductUnits</strong><small>Tüm kitlere git →</small></a>
            <a class="metric-card" asp-action="Inventory" asp-route-status="12"><span>Satılan kit</span><strong>@Model.SoldKits</strong><small>Satış geçmişine git →</small></a>
            <a class="metric-card" asp-action="Orders" asp-route-type="2"><span>Tamamlanan satış</span><strong>@Model.CompletedPurchaseOrders</strong><small>Satış siparişlerine git →</small></a>
            <a class="metric-card" asp-controller="Customers" asp-action="Index"><span>Müşteri</span><strong>@Model.Customers</strong><small>Müşterilere git →</small></a>
        </div>
    </section>
}
