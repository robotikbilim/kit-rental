@model OperationsDashboardViewModel
@{
    ViewData["Title"] = "Genel Bakış";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">YÖNETİM PANELİ</span>
        <h1>Genel Bakış</h1>
        <p class="block-muted">Sipariş, öğrenci adresi ve kargo durumlarını tek bakışta takip edin.</p>
    </div>
</div>

<section class="dashboard-group dashboard-group-general">
    <header class="dashboard-group-heading">
        <div><span class="eyebrow">SİPARİŞ VE KARGO ÖZETİ</span><h2>Güncel durum</h2></div>
        <p>Siparişlerdeki öğrenci adresleri ve Kargonomi gönderi durumları.</p>
    </header>
    <div class="metrics dashboard-metrics">
        <a class="metric-card" asp-action="Orders">
            <span>Toplam Sipariş Sayısı</span>
            <strong>@Model.TotalOrders</strong>
            <small>Siparişlere git →</small>
        </a>
        <a class="metric-card" asp-action="Orders">
            <span>Siparişlerdeki Toplam Öğrenci Sayısı</span>
            <strong>@Model.TotalStudents</strong>
            <small>Siparişlere git →</small>
        </a>
        <a class="metric-card metric-fault" asp-action="Orders">
            <span>Siparişlerdeki Adresi Girilmemiş, Adresi Beklenen Kayıtların Sayısı</span>
            <strong>@Model.StudentsAwaitingAddress</strong>
            <small>Siparişlere git →</small>
        </a>
        <a class="metric-card metric-repaired" asp-action="Orders">
            <span>Siparişlerdeki Adresi Girilmiş, Kargo Gönderimi Başlatılması Beklenen Kayıtların Sayısı</span>
            <strong>@Model.StudentsAwaitingShipment</strong>
            <small>Siparişlere git →</small>
        </a>
        <a class="metric-card metric-rented" asp-controller="Operations" asp-action="KargonomiShipments">
            <span>Kargo Gönderimi Başlatılmış, Teslimat Sürecindeki Kayıtlar</span>
            <strong>@Model.ShipmentsInTransit</strong>
            <small>Kargonomi gönderilerine git →</small>
        </a>
        <a class="metric-card metric-available" asp-controller="Operations" asp-action="KargonomiShipments">
            <span>Kargo Gönderimi Başlatılmış, Teslim Edildi Durumundaki Kayıtlar</span>
            <strong>@Model.ShipmentsDelivered</strong>
            <small>Kargonomi gönderilerine git →</small>
        </a>
    </div>
</section>

<section class="dashboard-group dashboard-group-returns">
    <header class="dashboard-group-heading">
        <div><span class="eyebrow">İADE SÜRECİ</span><h2>İade durumu</h2></div>
        <p>Süresi dolan kiralamalar ve iade sürecindeki kitler.</p>
    </header>
    <div class="metrics dashboard-metrics">
        <a class="metric-card metric-fault" asp-action="Returns">
            <span>İade Bekleniyor</span>
            <strong>@Model.ReturnPendingKitCount</strong>
            <small>İadelere git →</small>
        </a>
        <a class="metric-card metric-fault" asp-action="Returns">
            <span>Kargoda</span>
            <strong>@Model.ReturnInTransitKitCount</strong>
            <small>İadelere git →</small>
        </a>
        <a class="metric-card metric-repaired" asp-action="Returns">
            <span>İade Tamamlandı</span>
            <strong>@Model.ReturnCompletedKitCount</strong>
            <small>İadelere git →</small>
        </a>
    </div>
</section>

<section class="dashboard-group dashboard-group-faults">
    <header class="dashboard-group-heading">
        <div><span class="eyebrow">ARIZA TAKİBİ</span><h2>Arıza Takibi</h2></div>
        <p>Arıza kayıtlarının inceleme, onarım, kargo ve kapanış durumları.</p>
    </header>
    <div class="metrics dashboard-metrics">
        <a class="metric-card metric-fault" asp-action="Faults">
            <span>İnceleme Bekleyen Arıza Kayıtları</span>
            <strong>@Model.FaultsAwaitingReview</strong>
            <small>Arızalara git →</small>
        </a>
        <a class="metric-card metric-rented" asp-action="Faults">
            <span>Onarımdaki Arızalar</span>
            <strong>@Model.FaultsInRepair</strong>
            <small>Arızalara git →</small>
        </a>
        <a class="metric-card metric-rented" asp-action="Faults">
            <span>Kargo Bekleyen Arızalar</span>
            <strong>@Model.FaultsAwaitingShipment</strong>
            <small>Arızalara git →</small>
        </a>
        <a class="metric-card metric-available" asp-action="Faults">
            <span>Tamamlanmış Arızalar</span>
            <strong>@Model.FaultsCompleted</strong>
            <small>Arızalara git →</small>
        </a>
    </div>
</section>
