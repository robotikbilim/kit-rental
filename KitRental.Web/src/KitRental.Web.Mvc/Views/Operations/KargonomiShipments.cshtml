@model IReadOnlyCollection<KargonomiShipmentListItemViewModel>
@{
    ViewData["Title"] = "Kargonomi Gönderileri";
}
<div class="page-heading">
    <div><span class="eyebrow">KARGONOMİ</span><h1>Gönderiler</h1><p>Kargonomi hesabındaki @Model.Count gönderi</p></div>
</div>
@if (TempData["Success"] is string success) { <div class="success-banner">@success</div> }
@if (TempData["Error"] is string error) { <div class="error-banner">@error</div> }
<section class="detail-section">
    <div class="table-scroll">
        <table class="order-kits-table js-datatable">
            <thead><tr><th>Gönderi No</th><th>Alıcı</th><th>Telefon</th><th>Adres</th><th>Paket</th><th>Taşıyıcı</th><th>Takip No</th><th>Durum</th><th>Oluşturma</th><th>Güncelleme</th></tr></thead>
            <tbody>
            @foreach (var shipment in Model)
            {
                var address = string.Join(" / ", new[] { shipment.BuyerState, shipment.BuyerCity, shipment.BuyerAddress }
                    .Where(value => !string.IsNullOrWhiteSpace(value)));
                var isProblem = shipment.ExternalStatus is "error" or "failed" or "cancelled" or "canceled";
                <tr>
                    <td>#@shipment.Id</td>
                    <td>@shipment.BuyerName</td>
                    <td>@(shipment.BuyerPhone ?? "-")</td>
                    <td title="@address">@(string.IsNullOrWhiteSpace(address) ? "-" : address)</td>
                    <td>@shipment.PackageCount</td>
                    <td>@(shipment.Carrier ?? "-")</td>
                    <td>@(shipment.TrackingNumber ?? "-")</td>
                    <td><span class="@(isProblem ? "line-pending" : "line-complete")">@shipment.StatusLabel</span></td>
                    <td>@(shipment.CreatedAt.HasValue ? shipment.CreatedAt.Value.ToTurkeyTimeString("dd.MM.yyyy HH:mm") : "-")</td>
                    <td>@(shipment.UpdatedAt.HasValue ? shipment.UpdatedAt.Value.ToTurkeyTimeString("dd.MM.yyyy HH:mm") : "-")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
