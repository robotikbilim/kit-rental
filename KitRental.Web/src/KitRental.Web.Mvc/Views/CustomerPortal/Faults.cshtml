@model PortalFaultsPageViewModel
@{
    ViewData["Title"] = "Arizalar";
}
@functions {
    string StatusName(int value) => value switch
    {
        1 => "Kayit acildi",
        2 => "Inceleniyor",
        3 => "Bilgi bekleniyor",
        4 => "Kit bekleniyor",
        5 => "Serviste",
        6 => "Geri gonderiliyor",
        7 => "Cozuldu",
        8 => "Tamamlandi",
        _ => "Islemde"
    };
    string OriginName(int value) => value switch
    {
        2 => "Public Form",
        3 => "Müşteri Paneli",
        _ => "Operasyon"
    };

}

<div class="portal-heading portal-kits-heading">
    <div>
        <span class="eyebrow">SERVIS TAKIBI</span>
        <h1>Ariza Kayitlari</h1>
        <p>@Model.CustomerName hesabina ait ariza kayitlarini arayin, filtreleyin ve servis durumunu takip edin.</p>
    </div>
    <div class="recipe-actions"><a class="primary-action" asp-action="NewFault">Arıza Bildir</a></div>
</div>

<section class="portal-kit-list-shell">
    <div class="portal-kit-result-heading" aria-live="polite">
        <div><strong>@Model.TotalCount</strong> ariza kaydi bulundu</div>
        @if (Model.TotalCount != Model.TotalFaultCount)
        {
            <span>Toplam @Model.TotalFaultCount ariza kaydi icinde</span>
        }
    </div>

    @if (Model.Faults.Count > 0)
    {
        <div class="table-scroll portal-kit-table-wrap portal-table-no-frame">
            <table class="portal-kit-table js-datatable" data-datatable-responsive="false" data-datatable-page-length="10" data-datatable-column-filters="true">
                <thead>
                    <tr><th>Kayıt</th><th>Kaynak</th><th>Kit</th><th>Bildirim</th><th>Durum</th><th><span class="visually-hidden">İşlemler</span></th></tr>
                    <tr class="column-filter-row" data-dt-order="disable">
                        <th><input type="search" data-column-filter placeholder="Kayıt filtrele" aria-label="Kayıt sütununu filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Kaynak filtrele" aria-label="Kaynak sütununu filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Kit filtrele" aria-label="Kit sütununu filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Bildirim filtrele" aria-label="Bildirim sütununu filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Durum filtrele" aria-label="Durum sütununu filtrele" autocomplete="off" /></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var fault in Model.Faults)
                {
                    <tr>
                        <td data-mobile-label="Kayit"><strong>@fault.Number</strong><small class="block-muted">@fault.OpenedAt.ToTurkeyTimeString("dd.MM.yyyy HH:mm")</small></td>
                        <td data-mobile-label="Kaynak"><span class="fault-stage status-@fault.Origin">@OriginName(fault.Origin)</span></td>
                        <td data-mobile-label="Kit"><strong>@fault.KitName</strong><small class="block-muted">@fault.SerialNumber</small></td>
                        <td data-mobile-label="Bildirim"><span class="fault-category">@fault.Category</span><p>@fault.Description</p></td>
                        <td data-mobile-label="Durum"><span class="fault-stage status-@fault.Status">@StatusName(fault.Status)</span></td>
                        <td data-mobile-label="İşlemler">
                            <a class="icon-action icon-action-list" asp-action="Fault" asp-route-id="@fault.Id" title="Arıza Detayı" aria-label="Arıza detayını aç">
                                <i data-lucide="list"></i><span class="visually-hidden">Detay</span>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty portal-kit-empty">
            @if (Model.TotalFaultCount == 0)
            {
                <strong>Henuz ariza kaydiniz yok.</strong>
                <span>Aktif kitleriniz icin ariza bildirimi olusturabilirsiniz.</span>
            }
            else
            {
                <strong>Filtrelerle eslesen ariza kaydi bulunamadi.</strong>
                <span>Arama olcutlerini degistirin veya filtreleri temizleyin.</span>
            }
        </div>
    }
</section>

