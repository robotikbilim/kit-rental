@model RentalCohortDetailPageViewModel
@{
    ViewData["Title"] = Model.Cohort.Name;
    var studentsLocked = Model.Cohort.IsApproved;
    var openCreateStudentDialog = !ViewData.ModelState.IsValid && !Model.StudentForm.Id.HasValue;
    var shipmentsByStudentId = (Model.Cohort.KargonomiShipments ?? [])
        .GroupBy(shipment => shipment.StudentId)
        .ToDictionary(group => group.Key, group => group.OrderByDescending(shipment => shipment.UpdatedAt).First());
    var hasDeletableStudents = Model.Cohort.Students.Any(student =>
        !student.ProductUnitId.HasValue && !student.AssignmentId.HasValue && !shipmentsByStudentId.ContainsKey(student.Id));
}
<a class="back-link" asp-action="RentalPeriods">← Siparişlere Dön</a>
@if (TempData["Success"] is string success) { <div class="success-banner">@success</div> }
@if (TempData["Error"] is string error) { <div class="error-banner">@error</div> }

<section class="portal-section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">@Model.Cohort.StartDate.ToString("dd.MM.yyyy") - @Model.Cohort.EndDate.ToString("dd.MM.yyyy")</span>
            <h1>@Model.Cohort.Name</h1>
        </div>
        <div class="student-list-heading-actions">
            <a class="secondary-action" asp-action="ExportRentalPeriodStudents" asp-route-id="@Model.Cohort.Id">Excel Olarak İndir</a>
            @if (!studentsLocked)
            {
                <button class="primary-action" type="button" data-dialog-open="student-create-dialog">Yeni Öğrenci Ekle</button>
                <button class="secondary-action" type="button" data-dialog-open="student-import-dialog">Excel İle Yükle</button>
            }
        </div>
    </div>
    @if (studentsLocked)
    {
        <div class="info-banner">Bu sipariş admin tarafından onaylandığı için öğrenci ekleme ve düzenleme kilitlendi. Henüz fiziksel kit atanmamış öğrenciler silinebilir.</div>
    }
</section>

@if (Model.Cohort.Progress is not null)
{
    <partial name="_OrderProgress" model="Model.Cohort.Progress" />
}

@if (!studentsLocked)
{
    <dialog class="student-edit-dialog" id="student-create-dialog" aria-labelledby="student-create-title" data-auto-open="@(openCreateStudentDialog.ToString().ToLowerInvariant())">
        <form class="student-edit-modal" asp-action="SaveRentalPeriodStudent" method="post">
            <input type="hidden" name="Id" />
            <input type="hidden" asp-for="StudentForm.CohortId" name="CohortId" />
            <div asp-validation-summary="All" class="error"></div>
            <header>
                <div>
                    <span class="eyebrow">ÖĞRENCİ</span>
                    <h2 id="student-create-title">Yeni öğrenci ekle</h2>
                </div>
                <button class="icon-action icon-action-neutral" type="button" data-dialog-close title="Kapat" aria-label="Pencereyi Kapat">
                    <i data-lucide="x"></i>
                </button>
            </header>
            <div class="form-grid">
                <div class="field"><label asp-for="StudentForm.FullName"></label><input asp-for="StudentForm.FullName" name="FullName" /></div>
                <div class="field"><label asp-for="StudentForm.GuardianPhone"></label><input asp-for="StudentForm.GuardianPhone" name="GuardianPhone" type="tel" data-phone-mask="tr" /></div>
                <div class="field"><label asp-for="StudentForm.ProductModelId"></label><select asp-for="StudentForm.ProductModelId" name="ProductModelId"><option value="">Kit seçin</option>@foreach (var kit in Model.ProductModels) { <option value="@kit.Id">@kit.Name (@kit.Sku)</option> }</select></div>
            </div>
            <input type="hidden" name="AddressLine" value="" />
            <footer>
                <button class="secondary-action" type="button" data-dialog-close>Vazgeç</button>
                <button class="primary-action" type="submit">Kaydet</button>
            </footer>
        </form>
    </dialog>

    <dialog class="student-edit-dialog" id="student-import-dialog" aria-labelledby="student-import-title">
        <form class="student-edit-modal" asp-action="ImportRentalPeriodStudents" method="post" enctype="multipart/form-data">
            <input type="hidden" name="cohortId" value="@Model.Cohort.Id" />
            <header>
                <div>
                    <span class="eyebrow">TOPLU EKLEME</span>
                    <h2 id="student-import-title">Excel ile öğrenci yükle</h2>
                </div>
                <button class="icon-action icon-action-neutral" type="button" data-dialog-close title="Kapat" aria-label="Pencereyi Kapat">
                    <i data-lucide="x"></i>
                </button>
            </header>
            <a class="row-link" asp-action="RentalPeriodTemplate">Excel Şablonunu İndir</a>
            <div class="field">
                <label for="student-import-product">Yüklenen listeye ait eğitim kiti</label>
                <select id="student-import-product" name="productModelId" required>
                    <option value="">Kit seçin</option>
                    @foreach (var kit in Model.ProductModels.OrderBy(item => item.Name))
                    {
                        <option value="@kit.Id">@kit.Name (@kit.Sku)</option>
                    }
                </select>
            </div>
            <div class="field"><label>Öğrenci listesi Excel dosyası</label><input type="file" name="file" accept=".xlsx" required /></div>
            <footer>
                <button class="secondary-action" type="button" data-dialog-close>Vazgeç</button>
                <button class="primary-action" type="submit">Önizle Ve Yükle</button>
            </footer>
        </form>
    </dialog>
}
<section class="portal-section" id="student-addresses">
    <div class="section-heading"><div><span class="eyebrow">ÖĞRENCİ VE KARGO LİSTESİ</span><h2>Öğrenciler Ve Gönderi Durumları</h2></div><b>@Model.Cohort.Students.Count öğrenci</b></div>
    @if (hasDeletableStudents)
    {
        <form id="customer-bulk-student-delete-form"
              asp-action="DeleteRentalPeriodStudents"
              method="post"
              hidden
              data-confirm="Seçilen öğrenciler listeden silinsin mi?"
              data-datatable-bulk-label="Sil"
              data-datatable-bulk-class="dt-bulk-delete"
              data-datatable-selection-attribute="canDelete"
              data-datatable-bulk-disabled-title="Fiziksel kit atanmış veya kargo süreci başlatılmış kayıtlar silinemez.">
            <input type="hidden" name="cohortId" value="@Model.Cohort.Id" />
        </form>
    }
    @if (Model.Cohort.Students.Count == 0)
    {
        <div class="empty">Bu dönemde henüz öğrenci yok.</div>
    }
    else
    {
        <div class="table-scroll">
            <table class="order-kits-table student-order-table js-datatable"
                   data-datatable-responsive="false"
                   data-datatable-page-length="10"
                   data-datatable-column-filters="true"
                   data-datatable-select="@(hasDeletableStudents ? "multi" : "false")"
                   data-datatable-select-all-pages="true"
                   data-datatable-bulk-actions="@(hasDeletableStudents ? "customer-bulk-student-delete-form" : string.Empty)"
                   data-datatable-bulk-input="studentIds">
                <thead>
                    <tr><th><span class="visually-hidden">Seç</span></th><th>Öğrenci</th><th>Telefon</th><th>Fiziksel Kit</th><th>Kargo Durumu</th><th>Takip No</th><th>Adres</th><th>Adres Linki</th><th>İşlem</th></tr>
                    <tr class="column-filter-row" data-dt-order="disable">
                        <th></th>
                        <th><input type="search" data-column-filter aria-label="Öğrenci sütununu filtrele" placeholder="Öğrenci filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter aria-label="Telefon sütununu filtrele" placeholder="Telefon filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter aria-label="Fiziksel kit sütununu filtrele" placeholder="Kit filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter aria-label="Kargo durumu sütununu filtrele" placeholder="Durum filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter aria-label="Takip numarası sütununu filtrele" placeholder="Takip no filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter aria-label="Adres sütununu filtrele" placeholder="Adres filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter aria-label="Adres linki sütununu filtrele" placeholder="Adres linki filtrele" autocomplete="off" /></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var student in Model.Students)
                {
                    var addressUrl = Url.Action("Index", "PublicStudentAddress", new { token = student.PublicAddressToken }, Context.Request.Scheme) ?? string.Empty;
                    shipmentsByStudentId.TryGetValue(student.Id, out var shipment);
                    var canDelete = !student.ProductUnitId.HasValue && !student.AssignmentId.HasValue && shipment is null;
                    <tr data-select-value="@student.Id" data-can-delete="@canDelete.ToString().ToLowerInvariant()">
                        <td></td>
                        <td>
                            <strong class="student-name-truncate" title="@student.FullName">@student.FullName</strong>
                            @if (student.HasDeliveryForm)
                            {
                                <small class="block-muted">Teslim: @student.DeliveredTo - @student.DeliveryPhone</small>
                            }
                        </td>
                        <td>@student.GuardianPhone</td>
                        <td>
                            @if (student.ProductUnitId.HasValue)
                            {
                                <a class="student-kit-serial-truncate" title="@student.SerialNumber" asp-action="Kit" asp-route-id="@student.ProductUnitId.Value" target="_blank" rel="noopener">@student.SerialNumber</a>
                            }
                            else
                            {
                                <span class="line-pending">Atanmadı</span>
                            }
                        </td>
                        <td>
                            @if (shipment is null)
                            {
                                <span class="line-pending">Başlatılmadı</span>
                            }
                            else if (shipment.State == 6)
                            {
                                <span class="line-pending">Hata</span>
                            }
                            else
                            {
                                <span class="line-complete">@shipment.StatusLabel</span>
                            }
                            @if (shipment is not null)
                            {
                                <small class="block-muted">@shipment.Carrier · @shipment.UpdatedAt.ToTurkeyTimeString("dd.MM.yyyy HH:mm")</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(shipment?.LastError))
                            {
                                <small class="block-muted" title="@shipment.LastError">@shipment.LastError</small>
                            }
                        </td>
                        <td>@(shipment?.TrackingNumber ?? "-")</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(student.AddressLine))
                            {
                                <span class="student-address-truncate" title="@student.AddressLine">@student.AddressLine</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(addressUrl))
                            {
                                <a class="student-public-link-truncate" href="@addressUrl" target="_blank" rel="noopener" title="@addressUrl">@addressUrl</a>
                            }
                        </td>
                        <td>
                            <div class="student-row-actions student-shipment-actions" aria-label="Öğrenci işlemleri">
                                @if (!studentsLocked)
                                {
                                    <button class="icon-action icon-action-edit" type="button" title="Öğrenciyi Güncelle" aria-label="@($"{student.FullName} öğrencisini güncelle")"
                                        data-student-edit
                                        data-student-id="@student.Id"
                                        data-student-name="@student.FullName"
                                        data-student-phone="@student.GuardianPhone"
                                        data-student-address="@student.AddressLine"
                                        data-student-product="@student.ProductModelId">
                                        <i data-lucide="pencil"></i><span class="visually-hidden">Güncelle</span>
                                    </button>
                                }
                                @if (canDelete)
                                {
                                    <form asp-action="DeleteRentalPeriodStudent" method="post" class="inline-form">
                                        <input type="hidden" name="cohortId" value="@Model.Cohort.Id" />
                                        <input type="hidden" name="studentId" value="@student.Id" />
                                        <button class="icon-action icon-action-delete" type="submit" title="Öğrenciyi Sil" aria-label="@($"{student.FullName} öğrencisini sil")" data-confirm="@($"{student.FullName} öğrencisi listeden silinsin mi?")">
                                            <i data-lucide="trash-2"></i><span class="visually-hidden">Sil</span>
                                        </button>
                                    </form>
                                }
                                else if (student.ProductUnitId.HasValue || student.AssignmentId.HasValue || shipment is not null)
                                {
                                    var deleteDisabledTitle = student.ProductUnitId.HasValue || student.AssignmentId.HasValue
                                        ? "Fiziksel kit atanmış kayıt silinemez."
                                        : "Kargo süreci başlatılan kayıt silinemez.";
                                    <button class="icon-action icon-action-delete" type="button" disabled aria-disabled="true" title="@deleteDisabledTitle" aria-label="@($"{student.FullName} öğrencisi silinemez")">
                                        <i data-lucide="trash-2"></i><span class="visually-hidden">Silinemez</span>
                                    </button>
                                }
                                @if (student.AssignmentId.HasValue)
                                {
                                    @if (student.HasCompletedReturn)
                                    {
                                        <button class="icon-action icon-action-fault" type="button" disabled title="İade tamamlandığı için arıza kaydı oluşturulamaz" aria-label="@($"{student.FullName} için arıza kaydı oluşturulamaz")">
                                            <i data-lucide="wrench"></i><span class="visually-hidden">Arıza Kaydı Oluşturulamaz</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <a class="icon-action icon-action-fault" asp-action="NewFault" asp-route-assignmentId="@student.AssignmentId" target="_blank" rel="noopener" title="Arıza Kaydı Oluştur" aria-label="@($"{student.FullName} için arıza kaydı oluştur")">
                                            <i data-lucide="wrench"></i><span class="visually-hidden">Arıza Kaydı Oluştur</span>
                                        </a>
                                    }
                                    @if (student.HasActiveReturn || student.HasCompletedReturn)
                                    {
                                        <button class="icon-action icon-action-return" type="button" disabled title="İade Talebi Oluştur" aria-label="@($"{student.FullName} için iade talebi oluştur")">
                                            <i data-lucide="rotate-ccw"></i><span class="visually-hidden">İade Talebi Oluştur</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <a class="icon-action icon-action-return" asp-action="StartStudentReturn" asp-route-cohortId="@Model.Cohort.Id" asp-route-studentId="@student.Id" title="İade Talebi Oluştur" aria-label="@($"{student.FullName} için iade talebi oluştur")">
                                            <i data-lucide="rotate-ccw"></i><span class="visually-hidden">İade Talebi Oluştur</span>
                                        </a>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.Cohort.UnassignedKits.Count > 0)
{
    <section class="portal-section">
        <div class="section-heading"><div><span class="eyebrow">ATANMAMIŞ</span><h2>Öğrenciye teslim edilmemiş kitler</h2></div><b>@Model.Cohort.UnassignedKits.Count kit</b></div>
        <div class="table-scroll">
            <table class="order-kits-table js-datatable" data-datatable-page-length="10">
                <thead><tr><th>Kit</th><th>Seri numarası</th><th>QR</th></tr></thead>
                <tbody>
                @foreach (var kit in Model.Cohort.UnassignedKits)
                {
                    <tr><td>@kit.ProductModelName <small class="block-muted">@kit.ProductModelSku</small></td><td><code class="unit-serial">@kit.SerialNumber</code></td><td>@kit.QrCode</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@if (!studentsLocked)
{
    <dialog class="student-edit-dialog" id="student-edit-dialog" aria-labelledby="student-edit-title" data-auto-open="@(Model.StudentForm.Id.HasValue ? "true" : "false")">
        <form class="student-edit-modal" asp-action="SaveRentalPeriodStudent" method="post">
            <div asp-validation-summary="All" class="error"></div>
            <input type="hidden" id="edit-student-id" name="Id" value="@(Model.StudentForm.Id?.ToString() ?? string.Empty)" />
            <input type="hidden" name="CohortId" value="@Model.Cohort.Id" />
            <header>
                <div>
                    <span class="eyebrow">ÖĞRENCİ</span>
                    <h2 id="student-edit-title">Öğrenciyi güncelle</h2>
                </div>
                <button class="icon-action icon-action-neutral" type="button" data-student-edit-close title="Kapat" aria-label="Pencereyi Kapat">
                    <i data-lucide="x"></i>
                </button>
            </header>
            <div class="form-grid">
                <div class="field"><label for="edit-student-name">Öğrenci adı soyadı</label><input id="edit-student-name" name="FullName" value="@Model.StudentForm.FullName" maxlength="160" required /></div>
                <div class="field"><label for="edit-student-phone">Veli telefon numarası</label><input id="edit-student-phone" name="GuardianPhone" value="@Model.StudentForm.GuardianPhone" type="tel" data-phone-mask="tr" maxlength="40" required /></div>
                <div class="field">
                    <label for="edit-student-product">Eğitim kiti</label>
                    <select id="edit-student-product" name="ProductModelId" required>
                        <option value="">Kit seçin</option>
                        @foreach (var kit in Model.ProductModels)
                        {
                            if (Model.StudentForm.ProductModelId == kit.Id)
                            {
                                <option value="@kit.Id" selected>@kit.Name (@kit.Sku)</option>
                            }
                            else
                            {
                                <option value="@kit.Id">@kit.Name (@kit.Sku)</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <input type="hidden" id="edit-student-address" name="AddressLine" value="@Model.StudentForm.AddressLine" />
            <footer>
                <button class="secondary-action" type="button" data-student-edit-close>Vazgeç</button>
                <button class="primary-action" type="submit">Güncelle</button>
            </footer>
        </form>
    </dialog>
}
