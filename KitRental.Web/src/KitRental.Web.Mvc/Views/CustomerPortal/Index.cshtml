@model CustomerPortalDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Genel Bakış";
    var allKitLocations = Model.KitLocations.ToArray();
    var mapLocations = allKitLocations.Where(item => item.Latitude.HasValue && item.Longitude.HasValue).ToArray();
    var missingLocationCount = allKitLocations.Length - mapLocations.Length;
    var mapLocationsJson = JsonSerializer.Serialize(mapLocations,
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}
@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
}
<div class="portal-heading">
    <div>
        <span class="eyebrow">TACEV KIRALAMA PORTALI</span>
        <h1>Merhaba, @Model.CustomerName</h1>
        <p>Kitlerinizi, siparişlerinizi ve servis süreçlerinizi tek ekrandan takip edin.</p>
    </div>
    <div class="recipe-actions"><a class="secondary-action" asp-action="FindKit">QR İle Kit Bul</a></div>
</div>
@if (TempData["Success"] is string message) { <div class="success-banner">@message</div> }
@if (TempData["Error"] is string error) { <div class="error-banner">@error</div> }
<partial name="_PortalOperationsDashboard" model="Model.Operations!" />
<section class="dashboard-group kit-map-section">
    <header class="dashboard-group-heading">
        <div><span class="eyebrow">KİT KONUM HARİTASI</span><h2>Türkiye genelinde kit dağılımı</h2></div>
        <p>Hesabınıza ait teslim alınmış kitler teslim formundaki enlem ve boylam bilgisine göre yerleştirilir.</p>
    </header>
    @if (allKitLocations.Length == 0)
    {
        <div class="empty">Enlem ve boylam bilgisi kaydedilmiş teslim edilmiş kit bulunmuyor.</div>
    }
    else
    {
        <small class="kit-map-missing-location">Konum bilgisi olmayan kit: @missingLocationCount</small>
        <div class="kit-map-layout">
            <div class="kit-map-panel">
                <div id="turkey-kit-map" class="turkey-kit-map" data-locations='@Html.Raw(mapLocationsJson)' data-detail-url-template='@Url.Action("Kit", "CustomerPortal", new { id = "__id__" })'></div>
            </div>
        </div>
    }
</section>
@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
    <script src="~/js/turkey-kit-map.js" asp-append-version="true"></script>
}

