@model CustomerPortalViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Genel Bakış";
    var allKitLocations = Model.KitLocations.ToArray();
    var mapLocations = allKitLocations.Where(item => item.Latitude.HasValue && item.Longitude.HasValue).ToArray();
    var faultyCount = allKitLocations.Count(item => item.LocationCategory == "faulty");
    var returnCount = allKitLocations.Count(item => item.LocationCategory == "returning");
    var activeCount = allKitLocations.Count(item => item.LocationCategory == "active");
    var activeKits = Model.Kits.Where(item => item.AssignmentStatus == 2).ToArray();
    var activeFaultyKits = activeKits.Count(item => item.OpenFaultCount > 0 || item.UnitStatus is 8);
    var activeHealthyKits = activeKits.Length - activeFaultyKits;
    var expiredWithoutReturn = activeKits.Count(item => item.EndDate < DateOnly.FromDateTime(DateTime.UtcNow) && item.OpenFaultCount == 0);
    var expiredWithReturn = activeKits.Count(item => item.EndDate < DateOnly.FromDateTime(DateTime.UtcNow) && item.OpenFaultCount > 0);
    var missingLocationCount = allKitLocations.Length - mapLocations.Length;
    var modelOptions = allKitLocations
        .GroupBy(item => item.ProductModelId)
        .Select(group => new
        {
            ProductModelId = group.Key,
            KitName = group.First().KitName,
            KitSku = group.First().KitSku,
            Count = group.Count()
        })
        .OrderBy(item => item.KitSku)
        .ThenBy(item => item.KitName)
        .ToArray();
    var mapLocationsJson = JsonSerializer.Serialize(mapLocations,
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}
@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
}
<div class="portal-heading">
    <div>
        <span class="eyebrow">TACEV KIRALAMA PORTALI</span>
        <h1>Merhaba, @Model.CustomerName</h1>
        <p>Kitlerinizi, siparişlerinizi ve servis süreçlerinizi tek ekrandan takip edin.</p>
    </div>
    <div class="recipe-actions"><a class="secondary-action" asp-action="FindKit">QR ile kit bul</a></div>
</div>
@if (TempData["Success"] is string message) { <div class="success-banner">@message</div> }
@if (TempData["Error"] is string error) { <div class="error-banner">@error</div> }
<section class="metrics portal-metrics">
    <a class="metric-card portal-metric-active" asp-action="Kits" asp-route-status="5" title="@activeKits.Length aktif kit. @activeHealthyKits kit arızasız, @activeFaultyKits kit açık arıza veya servis durumunda."><span>Aktif Kitler</span><strong>@Model.ActiveKitCount</strong></a>
    <a class="metric-card portal-metric-faults" asp-action="Faults" asp-route-state="open" title="@Model.OpenFaultCount açık arıza kaydı."><span>Açık Arızalar</span><strong>@Model.OpenFaultCount</strong></a>
    <a class="metric-card portal-metric-closed" asp-action="Faults" asp-route-state="completed" title="@Model.CompletedFaultCount kapalı arıza kaydı."><span>Kapalı Arızalar</span><strong>@Model.CompletedFaultCount</strong></a>
    <a class="metric-card portal-metric-expired" asp-action="Returns" asp-route-state="pending" title="@Model.ExpiredRentalKitCount süresi dolan kit. Bunların @expiredWithReturn tanesinde iade süreci başlamış, @expiredWithoutReturn tanesinde henüz iade açılmamış."><span>Süresi Dolanlar</span><strong>@Model.ExpiredRentalKitCount</strong></a>
    <a class="metric-card portal-metric-processing" asp-action="Returns" asp-route-state="processing" title="@Model.ReturnProcessStartedKitCount kit iade sürecinde."><span>İade Sürecindekiler</span><strong>@Model.ReturnProcessStartedKitCount</strong></a>
    <a class="metric-card portal-metric-returned" asp-action="Returns" asp-route-state="returned" title="@Model.ReturnedKitCount kit iade edilmiş."><span>İade Edilenler</span><strong>@Model.ReturnedKitCount</strong></a>
</section>
<section class="dashboard-group kit-map-section">
    <header class="dashboard-group-heading">
        <div><span class="eyebrow">KİT KONUM HARİTASI</span><h2>Türkiye genelinde kit dağılımı</h2></div>
        <p>Hesabınıza ait teslim alınmış kitler teslim formundaki enlem ve boylam bilgisine göre yerleştirilir.</p>
    </header>
    @if (allKitLocations.Length == 0)
    {
        <div class="empty">Enlem ve boylam bilgisi kaydedilmiş teslim edilmiş kit bulunmuyor.</div>
    }
    else
    {
        var filterOptions = new (string Key, string Label, int Count)[]
        {
            ("faulty", "Arızalı Kitler", faultyCount),
            ("returning", "İade Sürecindeki Kitler", returnCount),
            ("active", "Aktif Kitler", activeCount)
        };
        <div class="kit-map-layout">
            <div class="kit-map-panel">
                <div class="kit-map-filters" role="group" aria-label="Harita filtreleri">
                    @foreach (var option in filterOptions)
                    {
                        <label class="kit-map-filter">
                            <input type="checkbox" class="kit-map-filter-input" value="@option.Key" checked />
                            <span><strong>@option.Label</strong><small>@option.Count kit</small></span>
                        </label>
                    }
                </div>
                <div class="kit-map-filter-tools">
                    <label class="kit-map-search">
                        <span>Seri numarası</span>
                        <input type="search" class="kit-map-serial-filter" placeholder="Seri no yazın" autocomplete="off" />
                    </label>
                    <div class="kit-map-model-filters" role="group" aria-label="Ürün modeli filtreleri">
                        <span>Ürün modeli</span>
                        @foreach (var option in modelOptions)
                        {
                            <label>
                                <input type="checkbox" class="kit-map-model-filter-input" value="@option.ProductModelId" checked />
                                <b>@option.KitName</b><small>@option.Count kit</small>
                            </label>
                        }
                    </div>
                    <small class="kit-map-missing-location">Konum bilgisi olmayan kit: @missingLocationCount</small>
                </div>
                <div id="turkey-kit-map" class="turkey-kit-map" data-locations='@Html.Raw(mapLocationsJson)' data-detail-url-template='@Url.Action("Kit", "CustomerPortal", new { id = "__id__" })'></div>
            </div>
            <aside class="kit-map-summary">
                <strong>@allKitLocations.Length kit sahada</strong>
                @foreach (var city in mapLocations.GroupBy(item => item.City).OrderByDescending(group => group.Count()).ThenBy(group => group.Key).Take(8))
                {
                    <span><b>@city.Key</b>@city.Count() kit · @city.Select(item => item.District).Distinct().Count() ilçe</span>
                }
            </aside>
        </div>
    }
</section>
@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
    <script src="~/js/turkey-kit-map.js" asp-append-version="true"></script>
}
