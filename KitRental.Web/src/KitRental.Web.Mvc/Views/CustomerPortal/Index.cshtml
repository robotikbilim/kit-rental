@model CustomerPortalViewModel
@{
    ViewData["Title"] = "Genel Bakis";
}
<div class="portal-heading">
    <div><span class="eyebrow">TACEV KIRALAMA PORTALI</span><h1>Merhaba, @Model.CustomerName</h1><p>Kitlerinizi, siparislerinizi ve servis sureclerinizi tek ekrandan takip edin.</p></div>
    <div class="recipe-actions"><a class="secondary-action" asp-action="FindKit">QR ile kit bul</a></div>
</div>
@if (TempData["Success"] is string message) { <div class="success-banner">@message</div> }
@if (TempData["Error"] is string error) { <div class="error-banner">@error</div> }
<section class="metrics portal-metrics">
    <a class="metric-card" asp-action="Kits" asp-route-status="5"><span>Kullanimdaki kit</span><strong>@Model.ActiveKitCount</strong><small>Kitleri filtrele</small></a>
    <a class="metric-card" asp-action="Faults" asp-route-state="open"><span>Acik ariza kaydi</span><strong>@Model.OpenFaultCount</strong><small>Acik arizalari gor</small></a>
    <a class="metric-card" asp-action="Faults" asp-route-state="completed"><span>Tamamlanmis ariza kaydi</span><strong>@Model.CompletedFaultCount</strong><small>Tamamlananlari gor</small></a>
</section>
