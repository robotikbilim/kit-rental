@model PortalKitsPageViewModel
@{
    ViewData["Title"] = "Kiralanmış Kitler";
}
@functions {
    string UnitStatus(int value) => value switch { 1 => "Hazır", 2 => "Rezerve", 3 => "Hazırlanıyor", 4 => "Teslimat yolunda", 5 => "Kullanımınızda", 6 => "Geri gönderiliyor", 7 => "Kontrolde", 8 => "Serviste", _ => "İşlemde" };

}

<div class="portal-heading portal-kits-heading">
    <div>
        <span class="eyebrow">KİRALANAN ÜRÜNLER</span>
        <h1>Kiralanmış Kitler</h1>
        <p>@Model.CustomerName hesabına ait kitleri arayın, filtreleyin ve yönetin.</p>
    </div>
    <div class="recipe-actions">
        <a class="secondary-action" asp-action="FindKit">▣ QR İle Kit Bul</a>
    </div>
</div>

<section class="portal-kit-list-shell">
    <div class="portal-kit-result-heading" aria-live="polite">
        <div><strong>@Model.TotalCount</strong> kit bulundu</div>
        @if (Model.TotalCount != Model.TotalKitCount)
        {
            <span>Toplam @Model.TotalKitCount kiralanmış kit içinde</span>
        }
    </div>

    @if (Model.Kits.Count > 0)
    {
        <div class="table-scroll portal-kit-table-wrap portal-table-no-frame">
            <table class="portal-kit-table js-datatable" data-datatable-responsive="false" data-datatable-page-length="10" data-datatable-column-filters="true">
                <thead>
                    <tr><th>Kit</th><th>Öğrenci</th><th>Seri numarası</th><th>Kiralama dönemi</th><th>Durum</th><th>Arıza</th><th><span class="visually-hidden">İşlemler</span></th></tr>
                    <tr class="column-filter-row" data-dt-order="disable">
                        <th><input type="search" data-column-filter placeholder="Kit filtrele" aria-label="Kit sütununu filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Öğrenci filtrele" aria-label="Öğrenci sütununu filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Seri no filtrele" aria-label="Seri numarası sütununu filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Dönem filtrele" aria-label="Kiralama dönemi sütununu filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Durum filtrele" aria-label="Durum sütununu filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Arıza filtrele" aria-label="Arıza sütununu filtrele" autocomplete="off" /></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var kit in Model.Kits)
                {
                    <tr>
                        <td data-mobile-label="Kit"><div class="table-kit"><img src="@ImageUrl.Kit(kit.ImageUrl)" alt="" /><div><strong>@kit.KitName</strong><small>@kit.KitSku · @kit.OrderNumber</small></div></div></td>
                        <td data-mobile-label="Öğrenci">
                            @if (!string.IsNullOrWhiteSpace(kit.AssignedStudentName))
                            {
                                <strong>@kit.AssignedStudentName</strong>
                                @if (!string.IsNullOrWhiteSpace(kit.AssignedStudentGuardianPhone))
                                {
                                    <small class="block-muted">@kit.AssignedStudentGuardianPhone</small>
                                }
                                @if (!string.IsNullOrWhiteSpace(kit.AssignedStudentPeriodName))
                                {
                                    <small class="block-muted">@kit.AssignedStudentPeriodName</small>
                                }
                            }
                            else
                            {
                                <span class="portal-no-fault">Öğrenci atanmamış</span>
                            }
                        </td>
                        <td data-mobile-label="Seri numarası"><a class="student-kit-serial-truncate" title="@kit.SerialNumber" asp-action="Kit" asp-route-id="@kit.ProductUnitId" target="_blank" rel="noopener">@kit.SerialNumber</a></td>
                        <td data-mobile-label="Kiralama dönemi"><span class="portal-kit-period">@kit.StartDate.ToString("dd.MM.yyyy")<small>@kit.EndDate.ToString("dd.MM.yyyy") tarihine kadar</small></span></td>
                        <td data-mobile-label="Durum"><span class="fleet-status status-@kit.UnitStatus">@UnitStatus(kit.UnitStatus)</span></td>
                        <td data-mobile-label="Arıza">@if (kit.OpenFaultCount > 0) { <span class="portal-alert">@kit.OpenFaultCount açık arıza</span> } else { <span class="portal-no-fault">Arıza yok</span> }</td>
                        <td data-mobile-label="İşlemler">
                            <div class="portal-table-actions">
                                <a class="icon-action icon-action-list" asp-action="Kit" asp-route-id="@kit.ProductUnitId" target="_blank" rel="noopener" title="Kit Detayı" aria-label="Kit detayını aç">
                                    <i data-lucide="list"></i><span class="visually-hidden">Detay</span>
                                </a>
                                @if (!kit.IsReturned && kit.AssignmentStatus == 2)
                                {
                                    <a class="icon-action icon-action-fault" asp-action="NewFault" asp-route-assignmentId="@kit.AssignmentId" target="_blank" rel="noopener" title="Arıza Kaydı Oluştur" aria-label="Arıza kaydı oluştur">
                                        <i data-lucide="triangle-alert"></i><span class="visually-hidden">Arıza Bildir</span>
                                    </a>
                                }
                                else
                                {
                                    var faultDisabledTitle = kit.IsReturned
                                        ? "İade edilmiş kit için arıza kaydı oluşturulamaz."
                                        : "Öğrenci ataması tamamlanmadan arıza kaydı oluşturulamaz.";
                                    <button class="icon-action icon-action-fault" type="button" disabled aria-disabled="true" title="@faultDisabledTitle" aria-label="Arıza kaydı oluşturulamaz">
                                        <i data-lucide="triangle-alert"></i><span class="visually-hidden">Arıza Bildir</span>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty portal-kit-empty">
            @if (Model.TotalKitCount == 0)
            {
                <strong>Henüz kiralanmış kitiniz bulunmuyor.</strong>
                <span>Yeni bir kiralama talebi oluşturarak başlayabilirsiniz.</span>
            }
            else
            {
                <strong>Filtrelerle eşleşen kit bulunamadı.</strong>
                <span>Arama ölçütlerini değiştirin veya filtreleri temizleyin.</span>
            }
        </div>
    }
</section>
