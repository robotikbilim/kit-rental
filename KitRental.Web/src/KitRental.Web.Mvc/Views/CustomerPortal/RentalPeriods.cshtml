@model RentalCohortsPageViewModel
@{
    ViewData["Title"] = "Siparişler";
    string ApprovalLabel(PortalRentalCohortViewModel cohort) => cohort.OrderStatus switch
    {
        null => "Sipariş oluşturulmadı",
        1 => "Taslak",
        2 => "Onaylanmamış",
        14 => "Onaylanmamış",
        15 => "Onaylanmamış",
        _ => "Onaylanmış"
    };
    string DetailLabel(PortalRentalCohortViewModel cohort) => cohort.OrderStatus.HasValue
        ? OperationsDisplay.OrderStatus(cohort.OrderStatus.Value) : "Öğrenci listesi hazırlanıyor";
    string StatusClass(PortalRentalCohortViewModel cohort) => cohort.OrderStatus is null ? "status-1" :
        cohort.OrderStatus is 1 or 2 or 14 or 15 ? "status-2" : "status-3";
}

<div class="portal-heading portal-kits-heading">
    <div>
        <span class="eyebrow">@Model.CustomerName</span>
        <h1>Siparişler</h1>
        <p>Sipariş dönemlerinizi oluşturun, filtreleyin ve öğrenci listelerini yönetin.</p>
    </div>
</div>
@if (TempData["Success"] is string success) { <div class="success-banner">@success</div> }
@if (TempData["Error"] is string error) { <div class="error-banner">@error</div> }

<section class="portal-kit-list-shell">
    <form method="get" class="portal-progress-filter">
        <label for="portal-order-focus">İlerleme durumu</label>
        <select id="portal-order-focus" name="focus"><option value="">Tüm siparişler</option>@foreach (var focus in OperationsDisplay.FocusOptions) { <option value="@focus.Key" selected="@(ViewData["OrderFocus"] as string == focus.Key)">@focus.Value</option> }</select>
        <button class="secondary-action" type="submit">Filtrele</button><a asp-action="RentalPeriods">Filtreyi temizle</a>
    </form>
    <div class="section-heading">
        <div><span class="eyebrow">SİPARİŞ LİSTESİ</span><h2>Oluşturulan siparişler</h2></div>
        <div class="rental-period-heading-actions">
            <b>@Model.TotalCount kayıt</b>
            <button class="primary-action" type="button" data-dialog-open="rental-period-dialog" data-rental-period-create>Yeni Sipariş Oluştur</button>
        </div>
    </div>
    <dialog class="student-edit-dialog" id="rental-period-dialog" aria-labelledby="rental-period-dialog-title" data-auto-open="@((!ViewData.ModelState.IsValid).ToString().ToLowerInvariant())">
        <form class="student-edit-modal" asp-action="SaveRentalPeriod" method="post">
            <input type="hidden" asp-for="Form.Id" name="Id" />
            <div asp-validation-summary="All" class="error"></div>
            <header>
                <div>
                    <span class="eyebrow" id="rental-period-dialog-eyebrow">YENİ SİPARİŞ</span>
                    <h2 id="rental-period-dialog-title">Sipariş dönemi oluştur</h2>
                </div>
                <button class="icon-action icon-action-neutral" type="button" data-dialog-close title="Kapat" aria-label="Pencereyi Kapat">
                    <i data-lucide="x"></i>
                </button>
            </header>
            @if (Model.PeriodNameOptions.Count > 0)
            {
                <datalist id="period-name-options">
                    @foreach (var periodName in Model.PeriodNameOptions)
                    {
                        <option value="@periodName"></option>
                    }
                </datalist>
            }
            <div class="form-grid">
                <div class="field rental-period-name-field">
                    <label asp-for="Form.Name">Sipariş dönemine isim verin veya eski dönemlerden seçin</label>
                    <input asp-for="Form.Name" name="Name" list="period-name-options" placeholder="Örn. 2026 Güz Robotik Dönemi" />
                </div>
                <div class="field"><label asp-for="Form.StartDate"></label><input asp-for="Form.StartDate" name="StartDate" type="date" /></div>
                <div class="field"><label asp-for="Form.EndDate"></label><input asp-for="Form.EndDate" name="EndDate" type="date" /></div>
            </div>
            <footer>
                <button class="secondary-action" type="button" data-dialog-close>Vazgeç</button>
                <button class="primary-action" type="submit">Kaydet</button>
            </footer>
        </form>
    </dialog>
    @if (Model.TotalCount == 0)
    {
        <div class="empty">@(Model.PeriodName is null && Model.ApprovalStatus is null && string.IsNullOrWhiteSpace(ViewData["OrderFocus"] as string) ? "Henüz sipariş dönemi oluşturulmadı." : "Filtrelerle eşleşen sipariş bulunamadı.")</div>
    }
    else if (Model.Cohorts.Count > 0)
    {
        <div class="table-scroll portal-kit-table-wrap portal-table-no-frame">
            <table class="portal-kit-table portal-orders-table js-datatable" data-datatable-state-save="false" data-datatable-responsive="false" data-datatable-page-length="10" data-datatable-column-filters="true">
                <thead>
                    <tr>
                        <th>Sipariş dönemi</th>
                        <th>Oluşturulma Tarihi</th>
                        <th>Tarih aralığı</th>
                        <th>Sipariş no</th>
                        <th>Öğrenci</th>
                        <th>Atanmış kit</th>
                        <th>Onay durumu</th>
                        <th><span class="visually-hidden">İşlemler</span></th>
                    </tr>
                    <tr class="column-filter-row" data-dt-order="disable">
                        <th><input type="search" data-column-filter placeholder="Dönem filtrele" aria-label="Sipariş dönemi filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Tarih filtrele" aria-label="Oluşturulma tarihi filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Aralık filtrele" aria-label="Tarih aralığı filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Sipariş no filtrele" aria-label="Sipariş numarası filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Öğrenci filtrele" aria-label="Öğrenci sayısı filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Kit filtrele" aria-label="Atanmış kit filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Durum filtrele" aria-label="Onay durumu filtrele" autocomplete="off" /></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var cohort in Model.Cohorts)
                {
                    <tr>
                        <td data-mobile-label="Sipariş dönemi"><strong>@cohort.Name</strong></td>
                        <td data-mobile-label="Oluşturulma Tarihi">@cohort.CreatedAt.ToTurkeyTimeString("dd.MM.yyyy HH:mm")</td>
                        <td data-mobile-label="Tarih aralığı"><span class="portal-kit-period">@cohort.StartDate.ToString("dd.MM.yyyy")<small>@cohort.EndDate.ToString("dd.MM.yyyy") tarihine kadar</small></span></td>
                        <td data-mobile-label="Sipariş no"><span class="@(cohort.OrderNumber is null ? "block-muted" : null)">@(cohort.OrderNumber ?? "Sipariş numarası oluşmadı")</span></td>
                        <td data-mobile-label="Öğrenci">@cohort.StudentCount</td>
                        <td data-mobile-label="Atanmış kit">@cohort.AssignedKitCount</td>
                        <td data-mobile-label="Onay durumu"><span class="fault-stage @StatusClass(cohort)">@ApprovalLabel(cohort)</span><small class="block-muted">@DetailLabel(cohort)</small>
                            @if (cohort.Progress is not null)
                            {
                                <small class="block-muted">@cohort.Progress.ShipmentInTransitCount kargoda · @cohort.Progress.ShipmentDeliveredCount teslim edildi</small>
                                <small class="block-muted">@cohort.Progress.AwaitingShipmentCount gönderim bekliyor · @cohort.Progress.ShipmentReadyCount kargo kabulü bekliyor</small>
                                @if (cohort.Progress.ShipmentFailedCount > 0) { <span class="portal-alert">@cohort.Progress.ShipmentFailedCount kargo hatası</span> }
                                @if (cohort.Progress.IsOverdue) { <span class="portal-alert">Kiralama süresi geçti</span> }
                            }
                        </td>
                        <td data-mobile-label="İşlemler">
                            <div class="portal-table-actions portal-order-actions">
                                <a class="icon-action icon-action-list" asp-action="RentalPeriod" asp-route-id="@cohort.Id"
                                   title="@(cohort.StudentCount == 0 ? "Öğrenci Listesi Oluştur" : "Öğrenci Listesi")"
                                   aria-label="@(cohort.StudentCount == 0 ? $"{cohort.Name} için öğrenci listesi oluştur" : $"{cohort.Name} öğrenci listesini aç")">
                                    <i data-lucide="list-plus"></i><span class="visually-hidden">@(cohort.StudentCount == 0 ? "Öğrenci Listesi Oluştur" : "Öğrenci Listesi")</span>
                                </a>
                                @if (!cohort.IsApproved)
                                {
                                    <button class="icon-action icon-action-edit" type="button" data-dialog-open="rental-period-dialog"
                                        data-rental-period-edit
                                        data-rental-period-id="@cohort.Id"
                                        data-rental-period-name="@cohort.Name"
                                        data-rental-period-start="@cohort.StartDate.ToString("yyyy-MM-dd")"
                                        data-rental-period-end="@cohort.EndDate.ToString("yyyy-MM-dd")"
                                        title="Siparişi Düzenle"
                                        aria-label="@($"{cohort.Name} siparişini düzenle")">
                                        <i data-lucide="pencil"></i><span class="visually-hidden">Düzenle</span>
                                    </button>
                                    <form asp-action="DeleteRentalPeriod" asp-route-id="@cohort.Id" method="post" class="inline-form"
                                        data-confirm="Bu siparişi ve bağlı onaylanmamış sipariş kaydını silmek istediğinize emin misiniz?">
                                        <button class="icon-action icon-action-delete" type="submit" title="Siparişi Sil" aria-label="@($"{cohort.Name} siparişini sil")">
                                            <i data-lucide="trash-2"></i><span class="visually-hidden">Sil</span>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    @foreach (var order in Model.StandaloneOrders ?? [])
    {
        <details class="portal-shipment-card">
            <summary><strong>@order.OrderNumber · @OperationsDisplay.OrderStatus(order.Status)</strong><small>@order.KitDescription</small></summary>
            <partial name="_OrderProgress" model="order" />
        </details>
    }
</section>
