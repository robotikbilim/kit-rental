@model PortalFaultRequestPageViewModel
@{ ViewData["Title"] = "Arıza Bildir"; }
<div class="public-fault-shell">
    <section class="public-fault-card">
        <a class="back-link" asp-action="Faults">← Arıza Kayıtlarıma Dön</a>
        <span class="eyebrow">ARIZA KAYDI</span>
        <h1>Kitte bir sorun mu var?</h1>
        <p class="block-muted">Formu doldurun; kaydınız doğrudan teknik ekibin ekranına açık arıza olarak düşer.</p>
        <div class="public-kit-summary"><span>Arıza bildirilecek fiziksel kit</span><strong>@Model.Form.KitName</strong><code>@Model.Form.SerialNumber</code></div>
        <form class="public-fault-form" asp-action="NewFault" method="post">
                <div asp-validation-summary="All" class="error"></div>
                <input asp-for="Form.AssignmentId" name="AssignmentId" type="hidden" />
                <input asp-for="Form.KitName" name="KitName" id="KitName" type="hidden" />
                <input asp-for="Form.SerialNumber" name="SerialNumber" id="SerialNumber" type="hidden" />
                <div class="field"><label asp-for="Form.ReporterName"></label><input asp-for="Form.ReporterName" name="ReporterName" id="ReporterName" autocomplete="name" placeholder="Adınız ve soyadınız" /><span asp-validation-for="Form.ReporterName" class="error"></span></div>
                <div class="field"><label asp-for="Form.ReporterPhone"></label><input asp-for="Form.ReporterPhone" name="ReporterPhone" id="ReporterPhone" type="tel" autocomplete="tel" inputmode="tel" data-phone-mask="tr" placeholder="0xxx xxx xx xx" /><span asp-validation-for="Form.ReporterPhone" class="error"></span></div>
                <div class="field"><label asp-for="Form.ReporterAddress"></label><textarea asp-for="Form.ReporterAddress" name="ReporterAddress" id="ReporterAddress" rows="3" autocomplete="street-address" placeholder="Kitin bulunduğu açık adresi yazın."></textarea><span asp-validation-for="Form.ReporterAddress" class="error"></span></div>
                <div class="field"><label asp-for="Form.Description"></label><textarea asp-for="Form.Description" name="Description" rows="6" placeholder="Sorunun ne zaman ve nasıl oluştuğunu kısaca anlatın."></textarea><span asp-validation-for="Form.Description" class="error"></span></div>
                <div class="form-actions public-fault-actions"><a class="secondary-action" asp-action="Faults">Vazgeç</a><button class="primary-action" type="submit">Arıza Kaydını Gönder</button></div>
        </form>
    </section>
</div>
