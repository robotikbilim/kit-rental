@model PortalReturnsPageViewModel
@{
    ViewData["Title"] = "İadeler";
}
@functions {
    string StateName(string value) => value switch
    {
        "pending" => "İade Bekleniyor",
        "processing" => "İade Sürecinde",
        "returned" => "İade Edildi",
        _ => "Tümü"
    };

}

<div class="portal-heading portal-kits-heading">
    <div>
        <span class="eyebrow">İADE TAKİBİ</span>
        <h1>İadeler</h1>
        <p>@Model.CustomerName hesabına ait süresi dolan ve iade akışındaki kitleri filtreleyin.</p>
    </div>
    <div class="recipe-actions"><a class="secondary-action" asp-action="Kits">Kitler</a></div>
</div>

<section class="portal-kit-list-shell">
    <div class="portal-kit-result-heading" aria-live="polite">
        <div><strong>@Model.TotalCount</strong> iade kaydı bulundu</div>
        @if (Model.TotalCount != Model.TotalKitCount)
        {
            <span>Toplam @Model.TotalKitCount kit içinde</span>
        }
    </div>

    @if (Model.Returns.Count > 0)
    {
        <div class="table-scroll portal-kit-table-wrap portal-table-no-frame">
            <table class="portal-kit-table js-datatable" data-datatable-responsive="false" data-datatable-page-length="10" data-datatable-column-filters="true">
                <thead>
                    <tr><th>Kit</th><th>Seri numarası</th><th>Kiralama dönemi</th><th>Durum</th><th>Arıza</th><th><span class="visually-hidden">İşlemler</span></th></tr>
                    <tr class="column-filter-row" data-dt-order="disable">
                        <th><input type="search" data-column-filter placeholder="Kit filtrele" aria-label="Kit sütununu filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Seri no filtrele" aria-label="Seri numarası sütununu filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Dönem filtrele" aria-label="Kiralama dönemi sütununu filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Durum filtrele" aria-label="Durum sütununu filtrele" autocomplete="off" /></th>
                        <th><input type="search" data-column-filter placeholder="Arıza filtrele" aria-label="Arıza sütununu filtrele" autocomplete="off" /></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Returns)
                {
                    <tr>
                        <td data-mobile-label="Kit"><div class="table-kit"><div><strong>@item.KitName</strong><small>@item.KitSku · @item.OrderNumber</small></div></div></td>
                        <td data-mobile-label="Seri numarası"><a class="student-kit-serial-truncate" title="@item.SerialNumber" asp-action="Kit" asp-route-id="@item.ProductUnitId" target="_blank" rel="noopener">@item.SerialNumber</a></td>
                        <td data-mobile-label="Kiralama dönemi"><span class="portal-kit-period">@item.StartDate.ToString("dd.MM.yyyy")<small>@item.EndDate.ToString("dd.MM.yyyy") tarihine kadar</small></span></td>
                        <td data-mobile-label="Durum"><span class="badge order-status-@item.ReturnStatus">@item.ReturnState</span></td>
                        <td data-mobile-label="Arıza">@if (item.OpenFaultCount > 0) { <span class="portal-alert">@item.OpenFaultCount açık arıza</span> } else { <span class="portal-no-fault">Arıza yok</span> }</td>
                        <td data-mobile-label="İşlemler">
                            <div class="portal-table-actions">
                                <a class="icon-action icon-action-list" asp-action="Kit" asp-route-id="@item.ProductUnitId" target="_blank" rel="noopener" title="Kit Detayı" aria-label="Kit detayını aç">
                                    <i data-lucide="list"></i><span class="visually-hidden">Detay</span>
                                </a>
                                @if (item.AssignmentStatus == 2 && item.ReturnStatus != 3)
                                {
                                    <a class="icon-action icon-action-fault" asp-action="NewFault" asp-route-assignmentId="@item.AssignmentId" target="_blank" rel="noopener" title="Arıza Kaydı Oluştur" aria-label="Arıza kaydı oluştur">
                                        <i data-lucide="triangle-alert"></i><span class="visually-hidden">Arıza Bildir</span>
                                    </a>
                                }
                                else if (item.ReturnStatus == 3)
                                {
                                    <span class="portal-no-fault">Salt okunur</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty portal-kit-empty">
            @if (Model.TotalCount == 0)
            {
                <strong>Henüz iade kaydı bulunmuyor.</strong>
                <span>Süresi dolan kitler veya başlatılmış iade akışları burada görünecek.</span>
            }
            else
            {
                <strong>Filtrelerle eşleşen iade kaydı bulunamadı.</strong>
                <span>Arama ölçütlerini değiştirin veya filtreleri temizleyin.</span>
            }
        </div>
    }
</section>
