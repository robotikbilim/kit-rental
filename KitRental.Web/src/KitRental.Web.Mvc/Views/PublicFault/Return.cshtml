@model PublicReturnFormViewModel
@{ ViewData["Title"] = "Kit Iadesi"; }
@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/public-location-map.css" asp-append-version="true" />
}
<div class="public-fault-shell">
    <section class="public-fault-card">
        <span class="eyebrow">KIT IADESI</span>
        <h1>Iade talebi baslat</h1>
        <p class="block-muted">Iade talebiniz operasyon ekibinin ekranina duser. Acik adresi girin, sonra haritada kargo alinacak noktayi secin.</p>
        <div class="public-kit-summary"><span>Okutulan urun</span><strong>@Model.KitName</strong><code>@Model.SerialNumber</code></div>
        <form method="post" class="public-fault-form" id="public-return-form">
            <input asp-for="QrCode" type="hidden" />
            <input asp-for="AccessToken" type="hidden" />
            <input asp-for="Latitude" type="hidden" />
            <input asp-for="Longitude" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="error"></div>
            <div class="field"><label asp-for="RequesterName"></label><input asp-for="RequesterName" autocomplete="name" placeholder="Ad soyad" /><span asp-validation-for="RequesterName" class="error"></span></div>
            <div class="field"><label asp-for="RequesterPhone"></label><input asp-for="RequesterPhone" type="tel" autocomplete="tel" inputmode="tel" data-phone-mask="tr" placeholder="0xxx xxx xx xx" /><span asp-validation-for="RequesterPhone" class="error"></span></div>
            <div class="field"><label asp-for="ReturnReason"></label><select asp-for="ReturnReason">
                <option value="">İade nedenini seçin</option>
                <option value="1">Eğitim Tamamlandı</option>
                <option value="2">Kayıt Silindi</option>
            </select><span asp-validation-for="ReturnReason" class="error"></span></div>
            <div class="field"><label asp-for="DeliveryMethod"></label><select asp-for="DeliveryMethod" id="return-delivery-method">
                <option value="1">Adresimden Alınsın</option>
                <option value="2">Kendim Bırakacağım</option>
            </select><span asp-validation-for="DeliveryMethod" class="error"></span></div>
            <div data-return-pickup-field><partial name="_AddressRegionFields" model='@(new AddressRegionFieldsViewModel("", Model.CityId, Model.DistrictId, Model.City, Model.District, "ReturnAddress", false))' />
            </div>
            <div class="field" data-return-pickup-field><label asp-for="ReturnAddress"></label><textarea asp-for="ReturnAddress" data-kargonomi-address rows="3" autocomplete="street-address" placeholder="Kargo alınacak açık adresi yazın."></textarea><span asp-validation-for="ReturnAddress" class="error"></span><small class="block-muted" data-kargonomi-address-warning role="status" aria-live="polite" hidden>Kargonomi bazı görünmeyen, emoji veya desteklenmeyen karakterleri kabul etmeyebilir. Bu karakterler gönderi hazırlanırken otomatik ayıklanır; Türkçe adresinizi yazabilirsiniz.</small></div>
            <div class="public-location-box" data-return-pickup-field>
                <button class="secondary-action" id="use-location" type="button">Konumumu Bul</button>
                <div id="public-location-map" class="public-location-map"></div>
                <span id="location-status">Konumumu bul ile pimi yakın noktaya getirin veya haritadan seçin.</span>
            </div>
            <button class="primary-action" id="return-submit-button" type="submit">@(Model.DeliveryMethod == 1 ? "Kurye Çağır" : "İade Talebi Oluştur")</button>
            <div class="public-return-loading" id="return-loading-message" role="status" aria-live="polite" hidden>
                <strong>Kargo Barkodu veya Takip Kodu Oluşturuluyor.</strong>
                <span>Bu ekran, Kargo Barkodu ya da Kargo Takip Kodu oluşana kadar açık kalacaktır.</span>
            </div>
        </form>
    </section>
</div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/js/public-kargonomi-address.js" asp-append-version="true"></script>
<script src="~/js/public-location.js" asp-append-version="true"></script>
<script>
    (() => {
        const method = document.getElementById('return-delivery-method');
        const pickupFields = document.querySelectorAll('[data-return-pickup-field]');
        const submitButton = document.getElementById('return-submit-button');
        const form = document.getElementById('public-return-form');
        const loadingMessage = document.getElementById('return-loading-message');
        let isSubmitting = false;
        const sync = () => {
            const isDropoff = method?.value === '2';
            pickupFields.forEach((field) => { field.hidden = isDropoff; });
            form?.querySelectorAll('[data-region-city],[data-region-district],textarea[name="ReturnAddress"]')
                .forEach(field => { field.required = !isDropoff; });
            if (submitButton && !isSubmitting) submitButton.textContent = isDropoff ? 'İade Talebi Oluştur' : 'Kurye Çağır';
        };
        method?.addEventListener('change', sync);
        form?.addEventListener('submit', (event) => {
            if (event.defaultPrevented || method?.value !== '1') return;
            if (isSubmitting) {
                event.preventDefault();
                return;
            }
            isSubmitting = true;
            if (submitButton) {
                submitButton.classList.add('is-loading');
                submitButton.disabled = true;
                submitButton.textContent = 'Kargo Kodu Oluşturuluyor...';
            }
            if (loadingMessage) loadingMessage.hidden = false;
            document.body.classList.add('is-page-busy');
        });
        sync();
    })();
</script>
