@model PublicFaultFormViewModel
@{ ViewData["Title"] = "Bildirim Alındı"; }
<div class="public-fault-shell">
    <section class="public-fault-card public-fault-success">
        <span class="success-mark">✓</span>
        <span class="eyebrow">BİLDİRİM ALINDI</span>
        <h1>Teşekkürler, @Model.ReporterName.</h1>
        <p><strong>@Model.KitName</strong> için arıza bildiriminiz TACEV yetkilisine iletildi. Onaydan sonra teknik ekip incelemeye başlayacak.</p>
    </section>
</div>
