@model PublicFaultFormViewModel
@{ ViewData["Title"] = "Ariza Kaydi"; }
@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/public-location-map.css" asp-append-version="true" />
}
<div class="public-fault-shell">
    <section class="public-fault-card">
        <span class="eyebrow">ARIZA KAYDI</span>
        <h1>Kitte bir sorun mu var?</h1>
        <p class="block-muted">Formu doldurun; kaydiniz dogrudan teknik ekibin ekranina acik ariza olarak duser.</p>
        <div class="public-kit-summary"><span>Okutulan urun</span><strong>@Model.KitName</strong><code>@Model.SerialNumber</code></div>
        <form method="post" class="public-fault-form">
            <input asp-for="FaultId" type="hidden" />
            <input asp-for="QrCode" type="hidden" />
            <input asp-for="Latitude" type="hidden" />
            <input asp-for="Longitude" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="error"></div>
            <div class="field"><label asp-for="ReporterName"></label><input asp-for="ReporterName" autocomplete="name" placeholder="Adiniz ve soyadiniz" /><span asp-validation-for="ReporterName" class="error"></span></div>
            <div class="field"><label asp-for="ReporterPhone"></label><input asp-for="ReporterPhone" type="tel" autocomplete="tel" inputmode="tel" data-phone-mask="tr" placeholder="0xxx xxx xx xx" /><span asp-validation-for="ReporterPhone" class="error"></span></div>
            <div class="field"><label asp-for="City"></label><select asp-for="City" data-selected="@Model.City"></select><span asp-validation-for="City" class="error"></span></div>
            <div class="field"><label asp-for="District"></label><select asp-for="District" data-selected="@Model.District"></select><span asp-validation-for="District" class="error"></span></div>
            <div class="field"><label asp-for="ReporterAddress"></label><textarea asp-for="ReporterAddress" rows="3" autocomplete="street-address" placeholder="Kitin bulundugu acik adresi yazin."></textarea><span asp-validation-for="ReporterAddress" class="error"></span></div>
            <div class="public-location-box">
                <button class="secondary-action" id="use-location" type="button">Konumumu Bul</button>
                <div id="public-location-map" class="public-location-map"></div>
                <span id="location-status">Konumumu bul ile pimi yakin noktaya getirin veya haritadan secin. Adres, il ve ilce otomatik doldurulur.</span>
            </div>
            <div class="field"><label asp-for="Description"></label><textarea asp-for="Description" rows="6" placeholder="Sorunun ne zaman ve nasil olustugunu kisaca anlatin."></textarea><span asp-validation-for="Description" class="error"></span></div>
            <button class="primary-action" type="submit">Arıza Kaydını Gönder</button>
        </form>
    </section>
</div>
<script src="~/js/tr-city-districts.js" asp-append-version="true"></script>
<script src="~/js/public-city-district.js" asp-append-version="true"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/js/public-location.js" asp-append-version="true"></script>
