@model PublicFaultFormViewModel
@{ ViewData["Title"] = "Ariza Kaydi"; }
<div class="public-fault-shell">
    <section class="public-fault-card">
        <span class="eyebrow">ARIZA KAYDI</span>
        <h1>Kitte bir sorun mu var?</h1>
        <p class="block-muted">Formu doldurun; kaydiniz dogrudan teknik ekibin ekranina acik ariza olarak duser.</p>
        <div class="public-kit-summary"><span>Okutulan urun</span><strong>@Model.KitName</strong><code>@Model.SerialNumber</code></div>
        <form method="post" class="public-fault-form">
            <input asp-for="QrCode" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="error"></div>
            <div class="field"><label asp-for="ReporterName"></label><input asp-for="ReporterName" autocomplete="name" placeholder="Adiniz ve soyadiniz" /><span asp-validation-for="ReporterName" class="error"></span></div>
            <div class="field"><label asp-for="ReporterPhone"></label><input asp-for="ReporterPhone" type="tel" autocomplete="tel" inputmode="tel" placeholder="05xx xxx xx xx" /><span asp-validation-for="ReporterPhone" class="error"></span></div>
            <div class="field"><label asp-for="ReporterAddress"></label><textarea asp-for="ReporterAddress" rows="3" autocomplete="street-address" placeholder="Kitin bulundugu acik adresi yazin."></textarea><span asp-validation-for="ReporterAddress" class="error"></span></div>
            <div class="field"><label asp-for="Description"></label><textarea asp-for="Description" rows="6" placeholder="Sorunun ne zaman ve nasil olustugunu kisaca anlatin."></textarea><span asp-validation-for="Description" class="error"></span></div>
            <button class="primary-action" type="submit">Ariza kaydini gonder</button>
        </form>
    </section>
</div>
